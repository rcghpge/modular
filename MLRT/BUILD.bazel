load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//bazel:api.bzl", "gentbl_cc_library", "gentbl_mlir_dialect", "modular_cc_library", "modular_nanobind_library", "modular_shared_library", "pkg_files", "td_library")
load("//bazel:config.bzl", "ALLOW_UNUSED_TAG")

# gazelle:default_visibility //MLRT:consumers
# gazelle:default_features layering_check,parse_headers

package(
    default_visibility = ["//MLRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

package_group(
    name = "consumers",
    packages = [
        "-//Support/...",
        "//...",
    ],
)

pkg_files(
    name = "docs",
    srcs = [
        ":GRTDialect.doc",
        ":MEFDialect.doc",
    ],
    prefix = "MLRT/GraphRT/docs",
)

bool_flag(
    name = "worker_stats",
    build_setting_default = False,
)

config_setting(
    name = "worker_stats_setting",
    flag_values = {":worker_stats": "true"},
)

