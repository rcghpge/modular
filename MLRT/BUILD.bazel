# Driver targets

# Shared device-to-worker affinity logic used by both the graph compiler
# (MGPPrimitives) and the Mojo cpuDevice (via CompilerRT). Lives in the Driver
# layer (rather than AsyncRT) because it depends on Driver/DeviceContextAPI, so
# that //AsyncRT stays a clean leaf with no edge back into the Driver code.
modular_cc_library(
    name = "Driver/DeviceAffinity",
    srcs = ["lib/Driver/DeviceContext/DeviceAffinity.cpp"],
    hdrs = ["include/MLRT/Driver/DeviceContext/DeviceAffinity.h"],
    includes = ["include"],
    visibility = ["//MLRT:consumers"],
    deps = [
        ":Driver/DeviceContextAPI",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:Configuration",
        "//Support:Threading",
        "@llvm-project//llvm:Support",
    ],
)

