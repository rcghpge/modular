load("//bazel:api.bzl", "modular_cc_library")
load("//bazel:config.bzl", "ALLOW_UNUSED_TAG")

# gazelle:default_visibility //MLRT:consumers
# gazelle:default_features layering_check,parse_headers

package(
    default_visibility = ["//MLRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

package_group(
    name = "consumers",
    packages = [
        "//GenericML/...",
        "//KGEN/...",
    ],
)

modular_cc_library(
    name = "Core",
    srcs = glob(["lib/Core/*.cpp"]),
    hdrs = glob(["include/MLRT/Core/*.h"]),
    deps = [
        "//AsyncRT:Runtime",
        "//Support:Base",
    ],
)

modular_cc_library(
    name = "Core/IO",
    srcs = glob([
        "lib/Core/IO/*.cpp",
    ]),
    hdrs = glob([
        "include/MLRT/Core/IO/*.h",
    ]),
    tags = [ALLOW_UNUSED_TAG],  # TODO: Remove once this library is used
    deps = [
        "//Support:ADT",
        "//Support:Base",
        "//Support:Filesystem",
        "@llvm-project//llvm:Support",
    ] + select({
        "//:linux_x86_64": ["@libcufile_x86_64//:libcufile"],
        "//:linux_aarch64": ["@libcufile_aarch64//:libcufile"],
        "//conditions:default": [],
    }),
)

modular_cc_library(
    name = "Core/Tensor",
    srcs = glob(["lib/Core/Tensor/*.cpp"]),
    hdrs = glob(["include/MLRT/Core/Tensor/*.h"]),
    deps = [
        "//AsyncRT:Runtime",
        "//Support:ADT",
        "//Support:Base",
        "//Support:ML",
        "//Support:Profiling",
        "//Support:TypeID",
        "@llvm-project//llvm:Support",
    ],
)
