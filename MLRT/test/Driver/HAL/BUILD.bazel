load("//bazel:api.bzl", "mojo_test")

package(
    default_visibility = ["//MLRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

mojo_test(
    name = "test_hal_driver.mojo.test",
    srcs = ["test_hal_driver.mojo"],
    data = select({
        "//:nvidia_gpu": ["//Target:CUDAPlugin.so"],
        "//:apple_gpu": ["//Target:MetalPlugin.so"],
        "//:amd_gpu": ["//Target:HIPPlugin.so"],
        "//conditions:default": [],
    }),
    env = select({
        "//:nvidia_gpu": {
            "MODULAR_DRIVER_PLUGINS": "CUDA@$(rootpath //Target:CUDAPlugin.so)",
        },
        "//:apple_gpu": {
            "MODULAR_DRIVER_PLUGINS": "Metal@$(rootpath //Target:MetalPlugin.so)",
        },
        "//:amd_gpu": {
            "MODULAR_DRIVER_PLUGINS": "HIP@$(rootpath //Target:HIPPlugin.so)",
        },
        "//conditions:default": {},
    }),
    tags = ["gpu"],
    target_compatible_with = select({
        "//:nvidia_gpu": [],
        "//:apple_gpu": [],
        "//:amd_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@mojo//:std",
        "@mojo//:test_utils",
    ],
)
