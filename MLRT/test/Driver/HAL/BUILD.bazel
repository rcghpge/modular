load("//bazel:api.bzl", "modular_cc_binary", "modular_py_test", "mojo_test")

package(
    default_visibility = ["//MLRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

# ---------------------------------------------------------------------------
# Mock plugin — lightweight C implementation of M_driver_* for testing the
# Mojo HAL bindings without GPU hardware.
# ---------------------------------------------------------------------------
modular_cc_binary(
    name = "MockPlugin.so",
    testonly = True,
    srcs = ["mock_plugin.c"],
    linkshared = True,
    linkstatic = False,
    deps = ["//SDK:HAL"],
)

# ---------------------------------------------------------------------------
# Mock-based test — runs without GPU, exercises full HAL lifecycle.
# ---------------------------------------------------------------------------
mojo_test(
    name = "test_hal_mock.mojo.test",
    srcs = ["test_hal_mock.mojo"],
    data = [":MockPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "Mock@$(rootpath :MockPlugin.so)",
    },
    deps = [
        "@mojo//:std",
        "@mojo//:test_utils",
    ],
)

# ---------------------------------------------------------------------------
# GPU-dependent smoke test (existing).
# ---------------------------------------------------------------------------
mojo_test(
    name = "test_hal_driver.mojo.test",
    srcs = ["test_hal_driver.mojo"],
    data = select({
        "//:nvidia_gpu": ["//Target:CUDAPlugin.so"],
        "//:apple_gpu": ["//Target:MetalPlugin.so"],
        "//:amd_gpu": ["//Target:HIPPlugin.so"],
        "//conditions:default": [],
    }),
    env = select({
        "//:nvidia_gpu": {
            "MODULAR_DRIVER_PLUGINS": "CUDA@$(rootpath //Target:CUDAPlugin.so)",
        },
        "//:apple_gpu": {
            "MODULAR_DRIVER_PLUGINS": "Metal@$(rootpath //Target:MetalPlugin.so)",
        },
        "//:amd_gpu": {
            "MODULAR_DRIVER_PLUGINS": "HIP@$(rootpath //Target:HIPPlugin.so)",
        },
        "//conditions:default": {},
    }),
    tags = ["gpu"],
    target_compatible_with = select({
        "//:nvidia_gpu": [],
        "//:apple_gpu": [],
        "//:amd_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@mojo//:std",
        "@mojo//:test_utils",
    ],
)

