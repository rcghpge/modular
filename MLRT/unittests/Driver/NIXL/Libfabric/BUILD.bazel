load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_test(
    name = "PluginTests",
    size = "small",
    srcs = ["PluginTests.cpp"],
    env = {
        "FI_EFA_USE_DEVICE_RDMA": "1",
    },
    target_compatible_with = select({
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//MLRT:Driver/DeviceContextImpl",
        "//MLRT:Driver/NIXL",
        "//MLRT:Driver/NIXLLibfabricUtils",
        "//MLRT/unittests/Driver:TestUtils",
        "//MLRT/unittests/Driver/NIXL:TestCommon",
    ],
)

modular_cc_test(
    name = "TopologyTests",
    size = "small",
    srcs = ["TopologyTests.cpp"],
    target_compatible_with = select({
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//MLRT:Driver/NIXLLibfabricUtils",
        "//MLRT/unittests/Driver/NIXL:TestCommon",
    ],
)

modular_cc_test(
    name = "BinaryNotificationTests",
    size = "small",
    srcs = ["BinaryNotificationTests.cpp"],
    target_compatible_with = select({
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//MLRT:Driver/NIXLLibfabricUtils",
    ],
)

modular_cc_binary(
    name = "LibfabricVramSmoke",
    srcs = ["LibfabricVramSmoke.cpp"],
    data = ["//MLRT:Driver/plugin_libfabric"],
    env = {
        "FI_EFA_USE_DEVICE_RDMA": "1",
        "FI_LOG_LEVEL": "warn",
        "MODULAR_NIXL_TELEMETRY_ENABLE": "y",
    },
    tags = ["gpu"],
    target_compatible_with = select({
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//MLRT:Driver/DeviceContextImpl",
        "//MLRT:Driver/NIXL",
        "//MLRT:Driver/NIXLLibfabricUtils",
    ],
)
