load("//bazel:api.bzl", "modular_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_test(
    name = "AgentTests",
    size = "small",
    srcs = ["AgentTests.cpp"],
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = [
        "//MLRT:Driver/NIXL",
        "//MLRT/unittests/Driver/NIXL:TestCommon",
        "@nixl_upstream//:nixl_api_headers",
    ],
)

modular_cc_test(
    name = "MetadataStreamTests",
    size = "small",
    srcs = ["MetadataStreamTests.cpp"],
    target_compatible_with = select({
        "//:linux_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@nixl_upstream//:nixl_api_headers",
        "@nixl_upstream//:nixl_stream",
    ],
)
