load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_test", "modular_shared_library")

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_test(
    name = "AgentTests",
    size = "small",
    srcs = ["AgentTests.cpp"],
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = [
        "//MLRT:Driver/NIXL",
        "//MLRT/unittests/Driver/NIXL:TestCommon",
    ],
)

modular_cc_test(
    name = "SharedInfraTests",
    size = "small",
    srcs = ["SharedInfraTests.cpp"],
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = [
        "//MLRT:Driver/NIXL",
        "//MLRT/unittests/Driver/NIXL:TestCommon",
    ],
)

modular_cc_test(
    name = "MetadataStreamTests",
    size = "small",
    srcs = ["MetadataStreamTests.cpp"],
    deps = [
        "//MLRT:Driver/NIXL",
    ],
)

modular_cc_binary(
    name = "NIXLLogTestHelper",
    srcs = ["NIXLLogTestHelper.cpp"],
    deps = [
        "//MLRT:Driver/NIXL",
    ],
)

modular_cc_test(
    name = "LoggingTests",
    size = "small",
    srcs = ["LoggingTests.cpp"],
    data = [":NIXLLogTestHelper"],
    env = {
        "TEST_NIXL_LOG_HELPER_PATH": "$(location :NIXLLogTestHelper)",
    },
    deps = [
        "//MLRT:Driver/NIXL",
        "//MLRT/unittests/Driver:TestUtils",
    ],
)

modular_cc_test(
    name = "TelemetryTests",
    size = "small",
    srcs = ["TelemetryTests.cpp"],
    deps = [
        "//MLRT:Driver/NIXL",
    ],
)

modular_shared_library(
    name = "telemetry_exporter_test_plugin",
    srcs = ["telemetry_exporter_test.cpp"],
    shared_lib_name = "libtelemetry_exporter_test.so",
    deps = [
        "//MLRT:Driver/NIXLTelemetryApiOnly",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_test(
    name = "TelemetryExporterTests",
    size = "small",
    srcs = ["TelemetryExporterTests.cpp"],
    data = [":telemetry_exporter_test_plugin"],
    env = {
        "TEST_TELEMETRY_PLUGIN_PATH": "$(rootpath :telemetry_exporter_test_plugin)",
    },
    deps = [
        "//MLRT:Driver/NIXL",
    ],
)
