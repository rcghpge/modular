load("//bazel:api.bzl", "modular_cc_test")

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

UCX_TEST_DEPS = [
    "//MLRT:Driver/DeviceContextImpl",
    "//MLRT:Driver/NIXL",
    "//MLRT/unittests/Driver/NIXL:TestCommon",
    "//MLRT/unittests/Driver:TestUtils",
    "//Support:Base",
    "@llvm-project//llvm:Support",
]

modular_cc_test(
    name = "TransferTests",
    size = "medium",
    srcs = ["TransferTests.cpp"],
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = UCX_TEST_DEPS,
)

modular_cc_test(
    name = "MetadataExchangeTests",
    size = "medium",
    srcs = ["MetadataExchangeTests.cpp"],
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = UCX_TEST_DEPS,
)

