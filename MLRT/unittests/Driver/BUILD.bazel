load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

# gazelle:default_visibility //visibility:private

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

# Header adding test helpers for using gtest with `ErrorOr<T>`.
modular_cc_library(
    name = "TestUtils",
    testonly = True,
    hdrs = [
        "TestUtils.h",
    ],
    visibility = [
        "//GenericML:__subpackages__",
    ],
    deps = [
        "@llvm-project//third-party/unittest:gmock",
    ],
)

modular_cc_test(
    name = "GPUMemoryManagerTest",
    size = "small",
    srcs = [
        "GPUMemoryManagerTest.cpp",
        "ScopedEnvVar.h",
    ],
    env = {
        # Set up consistent memory manager environment for testing
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SELF_CHECK": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "False",
    },
    gpu_constraints = select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_test(
    name = "DeviceContextTest",
    size = "small",
    srcs = ["DeviceContextTest.cpp"],
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
    ],
)

modular_cc_test(
    name = "VirtualDeviceContextTest",
    size = "small",
    srcs = ["VirtualDeviceContextTest.cpp"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
    ],
)

modular_cc_test(
    name = "GPUDeviceContextTest",
    size = "small",
    srcs = ["GPUDeviceContextTest.cpp"],
    # Setup environment ensuring that the memory manager is properly configured
    # for the tests being run.
    env = {
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE": "1073741824",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_CHUNK_PERCENT": "100",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "true",
        # Log memory manager operations for debugging.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "true",
        # These tests exercise the host memory manager, so give them 8GB
        # to use for the tests.
        "MODULAR_DEVICE_CONTEXT_HOST_MEMORY_MANAGER_SIZE": "8589934592",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
    ],
)

