load("@pip_deps//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "pipelines",
    srcs = ["pipelines.py"],
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_MAX_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
        "MODULAR_MOJO_MAX_COMPILERRT_PATH": "$(location //KGEN:CompilerRT)",
    },
    imports = ["."],
    deps = [
        requirement("click"),
        "//ModularFramework/examples/pipelines_python/llama3",
        "//ModularFramework/examples/pipelines_python/text_streaming",
        "//ModularFramework/examples/pipelines_python/utils",
    ],
)

filegroup(
    name = "pipelines_python",
    srcs = glob([
        "**/*.py",
    ]),
)
