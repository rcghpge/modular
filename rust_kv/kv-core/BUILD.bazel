load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//rust_kv:consumers"])

# Pure host code, so unlike kv-tier-connector this is not gated to a GPU
# platform. Its one third-party crate (sha2, for the SHA-256 block hash) is taken
# from the kv_core_crates universe, the only one the open-source export has.
# That universe only aliases a crate without its version for the direct
# dependencies of its workspace root, and kv-core is a path dependency of it, so
# the label carries the version. Bump it with rust_kv/kv-core-pyo3/Cargo.lock.
rust_library(
    name = "kv-core",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    deps = ["@kv_core_crates//:sha2-0.10.9"],
)

rust_test(
    name = "kv-core-test",
    crate = ":kv-core",
    edition = "2024",
    # A macOS binary links on the Linux remote executor, which has neither
    # `dsymutil` (split debuginfo) nor `rust-objcopy` (the opt-mode strip pass).
    rustc_flags = select({
        "@platforms//os:macos": [
            "-C",
            "split-debuginfo=off",
            "-C",
            "strip=none",
        ],
        "//conditions:default": [],
    }),
    # The sanitizer runners cannot load the ASAN runtime for Rust test binaries;
    # kv-core is safe Rust (`unsafe_code = "deny"`), so there is nothing to sanitize.
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:ubsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
