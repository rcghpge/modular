load("//bazel:api.bzl", "modular_cc_test")

# Regular tests without kernel logging
modular_cc_test(
    name = "BaseTests",
    srcs = glob(
        [
            "*.cpp",
        ],
        exclude = [
            "KernelLoggerTest.cpp",
        ],
    ),
    deps = [
        "//GenericML:MGPPrimitives",
        "//GenericML:SafeTensor",
        "//GenericML:Support",
        "//Support:Globals",
    ],
)

# Kernel logging tests - can run directly with: ./bazelw test //GenericML/unittests:KernelLoggerTests
modular_cc_test(
    name = "KernelLoggerTests",
    srcs = [
        "KernelLoggerTest.cpp",
    ],
    copts = ["-DENABLE_MGP_KERNEL_LOGGING"],
    tags = ["kernel_logging"],
    deps = [
        "//GenericML:MGPPrimitivesWithLogging",
        "//GenericML:SafeTensor",
        "//GenericML:Support",
        "//Support:Globals",
    ],
)
