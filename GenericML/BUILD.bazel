gentbl_cc_library(
    name = "MGPDialectIncGen",
    includes = ["include"],
    tbl_outs = [
        (
            ["-gen-op-decls"],
            "include/GenericML/MGPDialect/MGP.h.inc",
        ),
        (
            ["-gen-op-defs"],
            "include/GenericML/MGPDialect/MGP.cpp.inc",
        ),
        (
            [
                "-gen-dialect-decls",
                "-dialect=mgp",
            ],
            "include/GenericML/MGPDialect/MGPDialect.h.inc",
        ),
        (
            [
                "-gen-dialect-defs",
                "-dialect=mgp",
            ],
            "include/GenericML/MGPDialect/MGPDialect.cpp.inc",
        ),
        # Carry over from CMake. Original comment:
        # Type declarations need to be generated for MGPTypes.td directly so that
        # MGPTensorSpec is declared in its own include file (which is needed by
        # TensorTypeInterface). Type definitions for all types and TensorSpec need
        # to be generated in the same file so that there is only one copy of the type
        # parser.
        (
            [
                "-gen-typedef-defs",
                "-typedefs-dialect=mgp",
            ],
            "include/GenericML/MGPDialect/MGPTypes.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/GenericML/MGPDialect/MGP.td",
    deps = [
        ":MGPDialectTdFiles",
        "//GraphRT:GRTTdFiles",
    ],
)

