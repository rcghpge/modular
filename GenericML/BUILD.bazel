load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

td_library(
    name = "InterfacesTdFiles",
    srcs = glob(["include/GenericML/Interfaces/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

gentbl_cc_library(
    name = "InterfacesIncGen",
    includes = ["include"],
    strip_include_prefix = "include",
    tbl_outs = [
        (
            ["-gen-op-interface-decls"],
            "include/GenericML/Interfaces/GraphInterfaces.h.inc",
        ),
        (
            ["-gen-op-interface-defs"],
            "include/GenericML/Interfaces/GraphInterfaces.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/GenericML/Interfaces/GraphInterfaces.td",
    deps = [
        ":InterfacesTdFiles",
    ],
)

cc_library(
    name = "Interfaces",
    srcs = glob(["lib/Interfaces/*.cpp"]),
    hdrs = glob(["include/GenericML/Interfaces/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":InterfacesIncGen",
        "//Support:Base",
        "@llvm-project//mlir:IR",
    ],
)

td_library(
    name = "MODialectTdFiles",
    srcs = glob(["include/GenericML/GraphCompiler/MODialect/*.td"]),
    includes = ["include"],
    deps = [
        "//KGEN:KGENDialectTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

td_library(
    name = "MOGGDialectTdFiles",
    srcs = glob(["include/GenericML/GraphCompiler/MOGGDialect/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

td_library(
    name = "MGPDialectTdFiles",
    srcs = glob(["include/GenericML/MGPDialect/*.td"]),
    includes = ["include"],
    deps = [
        ":MODialectTdFiles",
        ":MOGGDialectTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

gentbl_cc_library(
    name = "MGPDialectIncGen",
    includes = ["include"],
    strip_include_prefix = "include",
    tbl_outs = [
        (
            ["-gen-op-decls"],
            "include/GenericML/MGPDialect/MGP.h.inc",
        ),
        (
            ["-gen-op-defs"],
            "include/GenericML/MGPDialect/MGP.cpp.inc",
        ),
        (
            [
                "-gen-dialect-decls",
                "-dialect=mgp",
            ],
            "include/GenericML/MGPDialect/MGPDialect.h.inc",
        ),
        (
            [
                "-gen-dialect-defs",
                "-dialect=mgp",
            ],
            "include/GenericML/Dialect/MGPDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/GenericML/MGPDialect/MGP.td",
    deps = [
        ":MGPDialectTdFiles",
        "//GraphRT:GRTTdFiles",
        "//GraphRT:MEFTdFiles",
        "//Support:MTdFiles",
    ],
)

cc_library(
    name = "MGPDialect",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/GenericML/MGPDialect/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":MGPDialectIncGen",
        ":Support",
    ],
)

cc_library(
    name = "Support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/GenericML/Support/**/*.h"]),
    strip_include_prefix = "include",
    deps = [
        "//ArraySupport",
        "//GraphRT:Primitives",
        "//KGEN:Compiler",
        "//KGEN:CompilerRT.headers",
        "//Support:Base",
        "//Support:ML",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:Transforms",
    ],
)

cc_library(
    name = "Assert",
    hdrs = ["include/GenericML/Support/Assert.h"],
    strip_include_prefix = "include",
    deps = [
        "@llvm-project//llvm:Support",
    ],
)

td_library(
    name = "TransformsTdFiles",
    srcs = glob(["include/GenericML/Transforms/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

gentbl_cc_library(
    name = "TransformsIncGen",
    includes = ["include"],
    strip_include_prefix = "include",
    tbl_outs = [
        (
            ["-gen-pass-decls"],
            "include/GenericML/Transforms/BisectGraphPass.h.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/GenericML/Transforms/BisectGraphPass.td",
    deps = [
        ":TransformsTdFiles",
        "@llvm-project//mlir:PassBaseTdFiles",
    ],
)

cc_library(
    name = "Transforms",
    srcs = glob(["lib/Transforms/*.cpp"]),
    hdrs = glob(["include/GenericML/Transforms/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":Interfaces",
        ":TransformsIncGen",
        "@llvm-project//mlir:Pass",
    ],
)

##
# MOSH dialect.
##

td_library(
    name = "MOSHDialectTdFiles",
    srcs = glob(["include/GenericML/GraphCompiler/MOSHDialect/*.td"]),
    includes = ["include"],
    deps = [
        "//KGEN:KGENDialectTdFiles",
        "@llvm-project//mlir:AttrTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:InferTypeOpInterfaceTdFiles",
        "@llvm-project//mlir:OpBaseTdFiles",
        "@llvm-project//mlir:SideEffectInterfacesTdFiles",
    ],
)

gentbl_cc_library(
    name = "MOSHDialectIncGen",
    includes = ["include"],
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-attrdef-decls",
                "-attrdefs-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHAttrs.h.inc",
        ),
        (
            [
                "-gen-attrdef-defs",
                "-attrdefs-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHAttrs.cpp.inc",
        ),
        (
            ["-gen-op-decls"],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSH.h.inc",
        ),
        (
            ["-gen-op-defs"],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSH.cpp.inc",
        ),
        (
            [
                "-gen-typedef-decls",
                "-typedefs-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHTypes.h.inc",
        ),
        (
            [
                "-gen-typedef-defs",
                "-typedefs-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHTypes.cpp.inc",
        ),
        (
            [
                "-gen-dialect-decls",
                "-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHDialect.h.inc",
        ),
        (
            [
                "-gen-dialect-defs",
                "-dialect=mosh",
            ],
            "include/GenericML/GraphCompiler/MOSHDialect/MOSHDialect.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/GenericML/GraphCompiler/MOSHDialect/MOSH.td",
    deps = [
        ":MOSHDialectTdFiles",
    ],
)

cc_library(
    name = "MOSHDialect",
    srcs = glob(["lib/GraphCompiler/MOSHDialect/*.cpp"]),
    hdrs = glob(["include/GenericML/GraphCompiler/MOSHDialect/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":MOSHDialectIncGen",
        ":Support",
        "//KGEN:KGENDialect",
        "//KGEN:POPDialect",
        "@llvm-project//mlir:IR",
    ],
)
