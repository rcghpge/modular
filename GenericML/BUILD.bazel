# We do this bonkers mosh-powered mojo to CPP header substitution into
# MoDialect, so we first need MOSH to make the Byte Code, and then we
# have a different python utility to convert that to a header. It's so
# absurd I kinda respect it.
genrule(
    name = "MoDialectShapeFunctionsByteCode",
    outs = ["ShapeFunctions.mlirbc"],
    srcs = [
        "lib/GraphCompiler/MODialect/ShapeFunctions.mojo",
        "//Kernels/mojo/stdlib",
        "//Kernels/mojo/math",
        "@llvm-project//compiler-rt:orc_rt",
        "//KGEN:CompilerRT.shared.file",
        "//GenericML/tools/mosh:mosh",
    ],
    cmd = """
$(location //GenericML/tools/mosh:mosh) \
$(location lib/GraphCompiler/MODialect/ShapeFunctions.mojo) \
-o $(location ShapeFunctions.mlirbc) \
-I `dirname -- $(location //Kernels/mojo/stdlib)` \
-I `dirname -- $(location //Kernels/mojo/math)`
""",
)

genrule(
    name = "MoDialectShapeFunctionsByteCodeHeader",
    outs = ["ShapeFunctions.mojo.h"],
    tools = ["//utils/build:binary_to_cpp"],
    srcs = [
        "ShapeFunctions.mlirbc"
    ],
    cmd = """
$(location //utils/build:binary_to_cpp) \
--input $(location ShapeFunctions.mlirbc) \
--output $(location ShapeFunctions.mojo.h) \
--namespace MojoMoshBindings
""",
)

cc_library(
    name = "MODialect",
    srcs = glob(["lib/GraphCompiler/MODialect/*.cpp"]) + ["ShapeFunctions.mojo.h"],
    hdrs = glob(["include/GenericML/GraphCompiler/MODialect/*.h"]),
    strip_include_prefix = "include",
    local_defines=[
        "MOSH_MOJO_BINDING_H='\"$(location ShapeFunctions.mojo.h)\"'"
    ],
    deps = [
        ":MODialectIncGen",
        ":MODialectEnumsIncGen",
        ":MODialectInterfacesIncGen",
        ":MOSHDialect",
        "//GraphRT:GRTDialect",
        "//GraphRT:MIPDialect",
        ":GraphCompilerMatchers",
        ":Interfaces",
        ":Support",
    ],
)

cc_library(
    name = "MOAnalysis",
    srcs = glob(["lib/GraphCompiler/Analysis/MODialect/*.cpp"]),
    hdrs = glob(["include/GenericML/GraphCompiler/Analysis/MODialect/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":MODialect",
    ],
)

