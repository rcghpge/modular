load("@//utils/bazel/build/rules:rpath_shim.bzl", "rpath_shim")
load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//visibility:public"])

modular_cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    data = [
        "//Faux/tools/faux",
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugin",
        "//PyTorch/tools/torch:mtorch",
    ],
    deps = [
        ":rpaths",
        "//GenericML:CommonDriver",
        "//Support:Globals",
        "//Support:Init",
    ],
)

rpath_shim(
    name = "rpaths",
    visibility = ["//visibility:private"],
    deps = [
        "//Faux/tools/faux",
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugin",
        "//PyTorch/tools/torch:mtorch",
    ],
)
