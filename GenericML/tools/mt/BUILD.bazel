load("//bazel:api.bzl", "modular_cc_binary", "rpath_shim")
load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES")

modular_cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    data = [
        "//ModularFramework/tools/max",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugins",
        "//PyTorch/tools/torch:mtorch",
    ],
    local_defines = ASYNCRT_PROFILING_LOCAL_DEFINES,
    deps = [
        ":rpaths",
        "//GenericML:CommonDriver",
        "//Init",
        "//Support:Globals",
    ],
)

rpath_shim(
    name = "rpaths",
    packages = [
        "//ModularFramework/tools/max",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugins",
        "//PyTorch/tools/torch:mtorch",
    ],
    visibility = ["//visibility:private"],
)
