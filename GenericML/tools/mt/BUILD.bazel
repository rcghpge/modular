load("//bazel:api.bzl", "modular_cc_binary", "rpath_shim", "run_tool")
load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES")

modular_cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    data = [
        "//Faux/tools/faux",
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugins",
        "//PyTorch/tools/torch:mtorch",
    ],
    local_defines = ASYNCRT_PROFILING_LOCAL_DEFINES,
    deps = [
        ":rpaths",
        "//AsyncRT:Init",
        "//GenericML:CommonDriver",
        "//Support:Globals",
    ],
)

rpath_shim(
    name = "rpaths",
    visibility = ["//visibility:private"],
    deps = [
        "//Faux/tools/faux",
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugins",
        "//PyTorch/tools/torch:mtorch",
    ],
)

run_tool(
    name = "mt-standalone",
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_CRASH_REPORTING_ENABLED": "false",
    },
    tags = ["manual"],
    tool = ":mt",
    visibility = ["//visibility:private"],
)
