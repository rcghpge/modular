load("@//utils/bazel/build/rules:rpath_shim.bzl", "rpath_shim")
load("//utils/bazel/build/rules:opt_wrapper.bzl", "opt_wrapper")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    data = [
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugin",
        "//PyTorch/tools/torch:mtorch",
    ],
    deps = [
        ":rpaths",
        "//GenericML:CommonDriver",
        "//Support:Globals",
        "//Support:Init",
    ],
)

rpath_shim(
    name = "rpaths",
    visibility = ["//visibility:private"],
    deps = [
        "//ModularFramework/tools/mof",
        "//ONNX/tools/onnx:monnx",
        "//PyTorch:StockTorchInterface",
        "//PyTorch:TorchRuntimePlugin",
        "//PyTorch/tools/torch:mtorch",
    ],
)

opt_wrapper(
    name = "mt.opt",
    dep = ":mt",
)
