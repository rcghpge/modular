load("//bazel:api.bzl", "modular_cc_binary")
load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES")

package(default_visibility = [
    "//:__pkg__",
    "//GenericML:__subpackages__",
])

modular_cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    local_defines = ASYNCRT_PROFILING_LOCAL_DEFINES,
    mojo_deps = [
        "//max:MOGGKernelAPI",
        "//max:MOGGPrimitives",
    ],
    deps = [
        "//GenericML:CommonDriver",
        "//GenericML:ExecutionDriver",
        "//GenericML:FrameworkFrontend",
        "//GenericML:MEFModel",
        "//GenericML:MOFOptions",
        "//Init",
        "//Support:Context",
        "//Support:Globals",
    ],
)
