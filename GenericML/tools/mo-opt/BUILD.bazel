load("//bazel:api.bzl", "modular_cc_binary")
load("//utils/bazel/build/rules:opt_wrapper.bzl", "opt_wrapper")

package(default_visibility = ["//visibility:public"])

modular_cc_binary(
    name = "mo-opt",
    srcs = glob(["*.cpp"]),
    deps = [
        "//GenericML:GraphCompiler",
        "//Support:Globals",
        "//Support:Init",
        "@llvm-project//mlir:MlirOptLib",
    ],
)

opt_wrapper(
    name = "mo-opt.opt",
    dep = ":mo-opt",
)
