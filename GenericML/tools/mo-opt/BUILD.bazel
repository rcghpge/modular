load("//bazel:api.bzl", "modular_cc_binary", "run_tool")

modular_cc_binary(
    name = "mo-opt",
    srcs = glob(["*.cpp"]),
    deps = [
        "//AsyncRT:Init",
        "//GenericML:GraphCompiler",
        "//Support:Globals",
        "@llvm-project//mlir:MlirOptLib",
    ],
)

run_tool(
    name = "mo-opt-standalone",
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
        # TODO(SDLC-918): remove when landed
        "//Kernels/mojo/Mogg:MOGG.lib.mlirbc",
        "//Kernels/mojo/Mogg:MOGGPrimitives.lib.mlirbc",
    ],
    tags = ["manual"],
    tool = ":mo-opt",
    visibility = ["//visibility:private"],
)
