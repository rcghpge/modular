load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = [
    "//:__pkg__",
    "//GenericML:__subpackages__",
])

modular_cc_binary(
    name = "mo-opt",
    srcs = glob(["*.cpp"]),
    data = select({
        "//:emit_mojo_enabled": ["//max:MOGGKernelAPI"],
        "//conditions:default": [],
    }),
    deps = [
        "//GenericML:GraphCompiler",
        "//Init",
        "//Support:Context",
        "//Support:Globals",
        "@llvm-project//mlir:MlirOptLib",
    ],
)
