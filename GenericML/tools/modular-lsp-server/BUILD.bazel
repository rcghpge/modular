load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = [
    "//:__pkg__",
    "//GenericML:__subpackages__",
])

modular_cc_binary(
    name = "modular-lsp-server",
    srcs = glob(["*.cpp"]),
    deps = [
        "//Cache",
        "//GenericML:MGPDialect",
        "//GenericML:MODialect",
        "//GenericML:MOGGDialect",
        "//GenericML:RMODialect",
        "//KGEN:ToolCommon",
        "@llvm-project//mlir:IndexDialect",
        "@llvm-project//mlir:MLProgramDialect",
        "@llvm-project//mlir:MlirLspServerLib",
    ],
)
