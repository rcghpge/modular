load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    srcs = glob(
        [
            "**/*.mlir",
            "**/*.yaml",
        ],
        exclude = [
            "GraphCompiler/Experimental/MHACoverage/mha-fusion-coverage-models.yaml",
        ],
    ),
    custom_substitutions = {
        "%kernel_api_test_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGKernelAPITestLib)",
    },
    data = [
        "//GenericML:MGPRT",
        "//KGEN:CompilerRT",
        "//Kernels/mojo/Mogg:MOGGKernelAPILib",
        "//Kernels/mojo/Mogg:MOGGKernelAPITestLib",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    generate_litcfg = True,
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GenericML/tools/mo-opt",
        "//GenericML/tools/model-specification-validator",
    ],
)
