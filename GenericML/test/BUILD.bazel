load("//utils/bazel/build/rules:lit.bzl", "lit_tests")

package(default_visibility = ["//visibility:public"])

lit_tests(
    name = "test",
    srcs = glob(
        [
            "**/*.mlir",
            "**/*.yaml",
        ],
        exclude = [
            # These fail
            "GraphCompiler/MOGGDialect/load-mojo-libs.mlir",
            "GraphCompiler/MOGGDialect/generated_code.mlir",

            # These always time out
            "GraphCompiler/Conversion/broadcast.mlir",
            "GraphCompiler/Conversion/cast.mlir",
            "GraphCompiler/Conversion/element-wise.mlir",
            "GraphCompiler/Conversion/pad.mlir",
            "GraphCompiler/Conversion/reshape.mlir",
            "GraphCompiler/Conversion/slice.mlir",
            "GraphCompiler/Conversion/split-compile.mlir",
            "GraphCompiler/Conversion/static-ops.mlir",
            "GraphCompiler/dlrm_snifftest.mlir",
            "GraphCompiler/MODialect/constant-fold-ops.mlir",
            "GraphCompiler/MODialect/dynamic_op_lowering.mlir",
            "GraphCompiler/MODialect/Transforms/constant-fold-large-const.mlir",
            "GraphCompiler/MODialect/Transforms/constant-fold.mlir",
            "GraphCompiler/MODialect/Transforms/shape-inference-e2e.mlir",
            "GraphCompiler/MODialect/Transforms/support-conversions-activations.mlir",
            "GraphCompiler/MODialect/Transforms/SymbolicizeFallbackShapeFuncs/pack-conv-transpose-filter.mlir",
            "GraphCompiler/MOGGDialect/many-unfused-broadcasts.mlir",
            "GraphCompiler/MOQDialect/transforms/legalize-moq-operators-to-mo-misc.mlir",
            "GraphCompiler/RMODialect/Lowering/binary_comparison.mlir",

            # Data not tests
            "GraphCompiler/Experimental/MHACoverage/mha-fusion-coverage-models.yaml",
        ],
    ),
    custom_substitutions = {
        "mo-cuda-opt": "$(rlocationpath //GenericML/tools/mo-cuda-opt:mo-cuda-opt.opt)",
        "%extra_test_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTests.lib.mlirbc.opt)",
        "%duplicate_override_mojo_bindings": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideFail.lib.mlirbc.opt)",
        "%override_succ_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideSucc.lib.mlirbc.opt)",
        "%override_extra_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideExtra.lib.mlirbc.opt)",
        "%experimental_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGExperimental.lib.mlirbc.opt)",
        "%dummy_kernels": "$(rlocationpath //Kernels/mojo/Mogg:MOGGExperimentalDummyKernels.lib.mlirbc.opt)",
    },
    data = [
        # These include a transitive dependency that conflicts with mo-opt.opt if they don't use the opt
        "//Kernels/mojo/Mogg:MOGGExperimental.lib.mlirbc.opt",
        "//Kernels/mojo/Mogg:MOGGExperimentalDummyKernels.lib.mlirbc.opt",
        "//Kernels/mojo/Mogg:MOGGTestOverrideExtra.lib.mlirbc.opt",
        "//Kernels/mojo/Mogg:MOGGTestOverrideFail.lib.mlirbc.opt",
        "//Kernels/mojo/Mogg:MOGGTestOverrideSucc.lib.mlirbc.opt",
        "//Kernels/mojo/Mogg:MOGGTests.lib.mlirbc.opt",
    ],
    tags = [
        "no-asan",
    ],
    tools = [
        "//GenericML/tools/cuda-opt",
        "//GenericML/tools/mo-cuda-opt:mo-cuda-opt.opt",
        "//GenericML/tools/mo-opt:mo-opt.opt",
        "//GenericML/tools/model-specification-validator",
        "//GenericML/tools/mosh-opt",
    ],
)
