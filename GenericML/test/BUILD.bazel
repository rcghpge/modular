load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    srcs = glob(
        [
            "**/*.mlir",
            "**/*.yaml",
        ],
        exclude = [
            "GraphCompiler/Experimental/MHACoverage/mha-fusion-coverage-models.yaml",
        ],
    ),
    custom_substitutions = {
        "%extra_test_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestsLib)",
        "%duplicate_override_mojo_bindings": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideFailLib)",
        "%override_succ_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideSuccLib)",
        "%override_extra_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGTestOverrideExtraLib)",
        "%experimental_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGExperimentalLib)",
        "%dummy_kernels": "$(rlocationpath //Kernels/mojo/Mogg:MOGGExperimentalDummyKernelsLib)",
        "%kernel_api_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGKernelAPILib)",
        "%kernel_api_test_lib": "$(rlocationpath //Kernels/mojo/Mogg:MOGGKernelAPITestLib)",
    },
    data = [
        "//KGEN:CompilerRT",
        "//Kernels/mojo/Mogg:MOGGExperimentalDummyKernelsLib",
        "//Kernels/mojo/Mogg:MOGGExperimentalLib",
        "//Kernels/mojo/Mogg:MOGGKernelAPILib",
        "//Kernels/mojo/Mogg:MOGGKernelAPITestLib",
        "//Kernels/mojo/Mogg:MOGGTestOverrideExtraLib",
        "//Kernels/mojo/Mogg:MOGGTestOverrideFailLib",
        "//Kernels/mojo/Mogg:MOGGTestOverrideSuccLib",
        "//Kernels/mojo/Mogg:MOGGTestsLib",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    requires_gpu = False,
    tags = ["gpu"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GenericML/tools/mo-opt",
        "//GenericML/tools/model-specification-validator",
        "//GenericML/tools/mosh-opt",
    ],
)
