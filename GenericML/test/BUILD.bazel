load("//bazel:api.bzl", "lit_tests")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "test",
    srcs = glob(
        [
            "**/*.mlir",
            "**/*.yaml",
        ],
        exclude = [
            "GraphCompiler/Experimental/MHACoverage/mha-fusion-coverage-models.yaml",
        ],
    ),
    custom_substitutions = {
        "%kernel_api_test_lib": "$(rlocationpath //GenericML/test/TestKernels:MOGGKernelAPITestLib)",
        "%kernel_api_test_pkg": "$(rlocationpath //GenericML/test/TestKernels:MOGGKernelAPITest)",
    },
    data = [
        "//GenericML/test/TestKernels:MOGGKernelAPITest",
        "//GenericML/test/TestKernels:MOGGKernelAPITestLib",
    ],
    mojo_deps = [
        "//max:MOGGKernelAPI",
        "//max:MOGGPrimitives",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GenericML/tools/mo-opt",
        "//GenericML/tools/model-specification-validator",
    ],
)
