    data = [
        "//Kernels/mojo/Mogg:MOGGExperimental.lib.mlirbc",
        "//Kernels/mojo/Mogg:MOGGExperimentalDummyKernels.lib.mlirbc",
        "//Kernels/mojo/Mogg:MOGGTestOverrideExtra.lib.mlirbc",
