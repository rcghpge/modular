load("//bazel:api.bzl", "mojo_library")

# gazelle:default_visibility //GenericML:__subpackages__

package(default_visibility = ["//GenericML:__subpackages__"])

mojo_library(
    name = "MOGGKernelAPITest",
    testonly = True,
    srcs = glob(["**/*.mojo"]),
    validate_missing_docs = False,
    deps = [
        "//max:compiler_internal",
        "//max:tensor",
        "@mojo//:std",
    ],
)

# Alias for backward compatibility - now always uses MOGGKernelAPITest since
# emit-mojo is always enabled.
alias(
    name = "MOGGKernelAPITestLibOrPkg",
    testonly = True,
    actual = ":MOGGKernelAPITest",
)
