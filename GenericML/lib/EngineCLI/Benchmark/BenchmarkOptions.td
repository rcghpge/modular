include "Support/Driver/CommonOptions.td"
include "Support/Driver/DriverCommand.td"

class EngineCLICommandDescription<string subcommand, string summary,
                                  string description, list<UsageInfo> usages>
    : CommandDescription</*executable=*/"max", subcommand, summary, description,
                         usages>;

def BenchmarkDescription
    : EngineCLICommandDescription<
          "benchmark", "Benchmark a model with the Modular AI Engine.",
          "Benchmarks a user-provided model with the Modular AI Engine running "
          "under mlperf-loadgen.  Inputs are randomly-generated by default but "
          "can be overridden with an input generation schema.",
          [UsageInfo<"options", "model path", /*variadicInput=*/false>]>,
      Index<1>;

def InputGenerationOptionGroup : OptionGroup<"Input generation options">,
                                 Index<1>;
def BenchmarkOptionGroup : OptionGroup<"Benchmarking options">, Index<2>;
def CompilationOptionGroup : OptionGroup<"Compilation options">, Index<3>;
def ExecutionOptionGroup : OptionGroup<"Execution options">, Index<4>;

def version : Flag<["--"], "version">,
              Group<CommonOptionGroup>,
              Index<1>,
              HelpText<"Displays version information.">;

defm mlperf_scenario
    : CommandOptionWithValues<
          ["--"], "mlperf-scenario", BenchmarkOptionGroup, Index<1>,
          MetaVarName<"SCENARIO">,
          HelpText<"MLPerf Inference scenario to test, out of:\n"
                   "\n"
                   "* `single-stream`\n"
                   "* `multiple-stream-2.0`\n"
                   "* `server`\n"
                   "* `offline`\n"
                   "\n"
                   "See https://mlcommons.org/en/inference-datacenter-30/"
                   "#scenarios-and-metrics for definitions.">,
          Values<"single-stream,multiple-stream-2.0,server,offline">>;

defm input_generation_schema
    : CommandOption<["--"], "input-generation-schema",
                    InputGenerationOptionGroup, Index<1>, MetaVarName<"PATH">,
                    HelpText<"Path to input generation schema file.">>;

def round_trip_input_generation_schema
    : Flag<["--"], "round-trip-input-generation-schema">,
      Group<InputGenerationOptionGroup>,
      Index<2>,
      HelpText<"Validate and round trip the provided input generation schema "
               "and do not proceed to run benchmarking.">,
      Flags<[HelpHidden]>;

defm custom_ops_path
    : CommandOption<["--"], "custom-ops-path", CompilationOptionGroup, Index<1>,
                    MetaVarName<"PATH">, HelpText<"Path to custom ops.">>;

defm num_threads
    : CommandOption<["--"], "num-threads", ExecutionOptionGroup, Index<1>,
                    MetaVarName<"N">, HelpText<"Number of threads to use.">>;
