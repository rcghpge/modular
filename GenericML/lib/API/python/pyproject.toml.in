# Use the setuptools build backend
[build-system]
requires = ["wheel", "setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "modular-engine"
version = "@MODULAR_VERSION_MAJOR@.@MODULAR_VERSION_MINOR@.@MODULAR_VERSION_PATCH@"
dependencies = [
  "numpy >= 1.18",
]
requires-python = ">=3.8"

[tool.setuptools]
license-files = [
  "EAP-Software-License",
  "Third-Party-Notices",
]

[tool.black]
include = '\.pyi?$'
line-length = 80
experimental-string-processing = true

[tool.cibuildwheel]
# {project} is the path to the working directory where `cibuildwheel` is run.
archs = ["native"]
before-all = "{project}/utils/build/engine_packaging/scripts/before-all.sh"
before-build = "{project}/utils/build/engine_packaging/scripts/before-build.sh"
build = "cp{38,39,310,311,312}-manylinux*"
build-frontend = "build"
environment-pass = [
  "AWS_ACCESS_KEY_ID",
  "AWS_DEFAULT_REGION",
  "AWS_REGION",
  "AWS_SECRET_ACCESS_KEY",
  "CI",
  "SCCACHE_BUCKET",
  "SCCACHE_CACHE_SIZE",
  "SCCACHE_C_CUSTOM_CACHE_BUSTER",
  "SCCACHE_DIR",
  "SCCACHE_GHA_ENABLED",
  "SCCACHE_IDLE_TIMEOUT",
  "SCCACHE_LOG",
  "SCCACHE_PATH",
  "SCCACHE_REGION",
  "SCCACHE_S3_KEY_PREFIX",
]
manylinux-x86_64-image = "ghcr.io/modularml/modular/ai-engine-packaging-x86_64:sha-f93bd2b"
manylinux-aarch64-image = "ghcr.io/modularml/modular/ai-engine-packaging-aarch64:sha-f93bd2b"
skip = ["cp36-* cp37-*, *-manylinux_i686", "*-musllinux*"]

# These requirements of numpy and pytest should already be satisfied, but this future-proofs us a bit
# in case the testing requirements change over time vs. the minimum of what the Python wheel
# itself requires (numpy) in addition to the implicitly-installed `pytest` package inside the
# `cibuildwheel` testing environment.

# These tests use generated models from `MODULAR_DERIVED_PATH` and require this environment variable to be set
# TODO: Renable the PyTorch API tests once we have `import modular.pytorch` working.
before-test = [
  "pip install -r {project}/TensorFlow/integration-test/API/python/pytests/requirements.txt"
  # "pip install -r {project}/PyTorch/integration-test/API/python/pytests/requirements.txt",
  # "pip install {project}/.derived/third-party/stock-pytorch/download/*.whl"
]
test-command = "MODULAR_DERIVED_PATH={project}/.derived pytest {project}/TensorFlow/integration-test/API/python/pytests"


[tool.cibuildwheel.linux]
# TODO(#11188): Enable `auditwheel`.
repair-wheel-command = ""

[tool.isort]
profile = "black"
