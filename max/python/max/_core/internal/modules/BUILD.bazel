load("//bazel:api.bzl", "modular_nanobind_library")

package(default_visibility = ["//max:consumers"])

modular_nanobind_library(
    name = "modules",
    srcs = [
        "dlpack.cpp",
        "driver.cpp",
        "dtype.cpp",
        "engine.cpp",
        "graph.cpp",
        "metrics.cpp",
        "nixl.cpp",
        "profiler.cpp",
        "request_context.cpp",
        "safetensors.cpp",
        "xgrammar.cpp",
        "xxhash.cpp",
    ],
    local_defines = [
        # Set definition used in Interop.h to prefix the MLIR package.
        "MLIR_PYTHON_PACKAGE_PREFIX=max._mlir.",
    ],
    deps = [
        "//Init",
        "//Support:Log",
        "//Support:ML",
        "//Support:Metrics",
        "//Support:Profiling",
        "//Support:ProfilingRanges",
        "//Support:RequestContext",
        "//max/lib/mcl:max",
        "//max/python/max/_core/internal:AsyncRTPython",
        "//max/python/max/_core/internal:DriverPython",
        "//max/python/max/_core/internal:EnginePython",
        "//max/python/max/_core/internal:GraphPython",
        "//max/python/max/_core/internal:ProfilerPython",
        "//max/python/max/_core/internal/modules/dialects:Builtin",
        "//max/python/max/_core/internal/modules/dialects:KGEN",
        "//max/python/max/_core/internal/modules/dialects:M",
        "//max/python/max/_core/internal/modules/dialects:MO",
        "//max/python/max/_core/internal/modules/dialects:MOSH",
        "//max/python/max/_core/internal/modules/dialects:RMO",
        "@llvm-project//llvm:Support",
        "@nixl_upstream//:nixl_api_headers",
        "@xgrammar",
        "@xxhash",
    ],
)
