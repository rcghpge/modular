#
# Request and response types for cascade generative-AI pipelines.
#
# This is the single definition of these types for every language. Python
# imports it as `max.experimental.cascade.interfaces.gen_ai_capnp` (pycapnp's
# import hook); Rust bindings are generated at build time. Builders write
# fields straight into a message's arena and readers are views over it.
#
# One interface covers every modality. A pipeline streams chunks that are
# already structured -- assistant text, reasoning, tool calls, images --
# rather than regions a consumer has to recover from a flat character stream.
# The same chunks are message content, so a conversation turn and a generated
# response share one vocabulary. In a message every chunk is whole; in a
# stream successive chunks are fragments to concatenate.
#
# Cap'n Proto has no optional scalars, so an optional scalar is a union of
# `unset` and `value`; `gen_ai.optional()` reads one as `None` or the value.

@0xe93f6d5eca3430e9;

using Cascade = import "/max/experimental/cascade/core/cascade.capnp";

struct GenAIChunk {
  union {
    # Assistant-visible text.
    text @0 :Text;
    # Model chain-of-thought, with the model's delimiters already stripped.
    reasoning @1 :Text;
    toolCall @2 :GenAIToolCall;
    image @3 :GenAIImage;
  }
  # Generated tokens this chunk accounts for, 0 when unknown.
  #
  # Attributed by the parser, which buffers across deltas: the tokens consumed
  # since its last emission land on the first chunk of the next flush, and later
  # chunks in that flush carry 0. Individual values are therefore lumpy; the sum
  # over a stream is exact, which is what usage and the rate metrics need.
  numTokens @4 :Int64 = 0;
}

# What a detokenizer emits: decoded text plus the tokens it came from.
#
# Different from a `GenAIChunk` in that the text has not been parsed and may
# still hold the reasoning delimiters and tool-call markers.
struct RawTextChunk {
  text @0 :Text;
  # Generated tokens this chunk accounts for.
  #
  # Not one per chunk: a token whose piece is held back mid-character
  # contributes to whichever chunk completes it. The sum over a stream is
  # therefore the exact generated total, which is what usage and the rate
  # metrics need.
  numTokens @1 :Int64 = 0;
}

# A request from the model to invoke a tool.
#
# Streamed, arguments arrive a JSON fragment at a time and only the first
# fragment of a call carries its `id` and `name`; consecutive fragments sharing
# an `index` are one call, and their `arguments` concatenate into the final
# JSON object. In a message (a replayed assistant turn) a call is complete.
struct GenAIToolCall {
  index @0 :Int64;
  id @1 :Text;
  name @2 :Text;
  arguments @3 :Text;
}

# An image, generated by the model or supplied with a prompt. Generated images
# always carry `data`; a pipeline that cannot fetch a `url` input should
# reject it rather than ignore it.
struct GenAIImage {
  # "PNG", "JPEG", ...
  format @0 :Text = "PNG";
  source :union {
    data @1 :Data;
    url @2 :Text;
  }
}

# One turn of a conversation.
struct ChatMessage {
  # "system", "user", "assistant", or "tool".
  role @0 :Text;
  content @1 :List(GenAIChunk);
  # For a "tool" turn, the id of the call this message answers.
  toolCallId @2 :Text;
}

# A tool the model may call, described independently of any wire format.
struct GenAITool {
  name @0 :Text;
  description @1 :Text;
  # JSON Schema for the tool's arguments, as JSON text. Parsers for models
  # whose tool grammar loses argument types use it to re-type scalars.
  parametersJson @2 :Text;
}

# Generation parameters for the text output of a single request, mirroring
# the sampling fields MAX Serve accepts on its OpenAI text routes. An unset
# optional means "use the model / server default".
struct TextGenOptions {
  # Maximum new tokens to generate (maps to `max_new_tokens`).
  numTokens @0 :Int64 = 10;
  minNewTokens @1 :Int64 = 0;
  # Keep generating past EOS until the token budget or a stop condition.
  ignoreEos @2 :Bool = false;
  # 0.0 is greedy decoding.
  temperature @3 :Float64 = 1.0;
  topK :union { unset @4 :Void; value @5 :Int64; }
  topP :union { unset @6 :Void; value @7 :Float64; }
  # Minimum token probability relative to the most likely token.
  minP :union { unset @8 :Void; value @9 :Float64; }
  # Temperature override for tokens inside a reasoning region.
  thinkingTemperature :union { unset @10 :Void; value @11 :Float64; }
  # Unset picks a random seed.
  seed :union { unset @12 :Void; value @13 :Int64; }
  frequencyPenalty :union { unset @14 :Void; value @15 :Float64; }
  presencePenalty :union { unset @16 :Void; value @17 :Float64; }
  # Factor by which logits of repeated tokens are divided.
  repetitionPenalty :union { unset @18 :Void; value @19 :Float64; }
  stop @20 :List(Text);
  stopTokenIds @21 :List(Int64);
}

# Generation parameters for the image output of a single request.
struct ImageGenOptions {
  height @0 :Int64 = 1024;
  width @1 :Int64 = 1024;
  numSteps @2 :Int64 = 28;
  guidanceScale @3 :Float64 = 3.5;
  seed @4 :Int64 = 42;
  outputFormat @5 :Text = "PNG";
}

# Whether the model may, must not, or must call a tool.
enum ToolChoice {
  auto @0;
  none @1;
  required @2;
}

# A single generation request, whatever its modalities. Options are grouped
# per output modality, so a pipeline that generates both reads each group and
# one that generates one ignores the other's defaults.
struct GenAIRequest {
  messages @0 :List(ChatMessage);
  # Tools the model may call. Empty means it must not call any, so a stray
  # marker in ordinary prose is never misread as a call.
  tools @1 :List(GenAITool);
  toolChoice @2 :ToolChoice = auto;
  text @3 :TextGenOptions;
  image @4 :ImageGenOptions;
}

# Scalars and lists a method takes or returns when it has no richer type. A
# call's i-th argument is one message rooted at the i-th parameter's struct, so
# a bare value travels as a one-field struct; `RustRuntime` fills and unwraps
# these from plain Python values.
struct Int64Value { value @0 :Int64; }
struct Float64Value { value @0 :Float64; }
struct BoolValue { value @0 :Bool; }
struct TextValue { value @0 :Text; }
struct TokenIds { ids @0 :List(UInt32); }
struct ChatMessages { messages @0 :List(ChatMessage); }

# Tokenizes text for a model. Each method takes and returns structs; a stream
# argument yields messages of its parameter's struct. A worker whose
# constructor takes configuration reads it from `<Worker>Config`.
struct TokenizerConfig { model @0 :Text; }

interface Tokenizer {
  encode @0 (text :TextValue) -> TokenIds;
  # Applies the model's chat template, then tokenizes.
  encodeChat @1 (messages :ChatMessages) -> TokenIds;
  decode @2 (skipSpecialTokens :BoolValue, tokens :TokenIds) -> TextValue;
  # Streams text pieces, with the tokens they account for, as token chunks
  # arrive.
  decodeStream @3 (skipSpecialTokens :BoolValue,
                   tokens :Cascade.ResultIter(TokenIds))
      -> (items :Cascade.ResultIter(RawTextChunk));
}
