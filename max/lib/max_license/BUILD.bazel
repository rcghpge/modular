load("//bazel:api.bzl", "modular_cc_library", "modular_shared_library")

package(default_visibility = ["//max:consumers"])

modular_cc_library(
    name = "MOFDriver",
    srcs = glob(["MOF/Driver/**/*.cpp"]),
    hdrs = ["//max/include/max/max_license:MOFDriver.headers"],
    deps = [
        "//GraphCompiler",
        "//Support:Base",
        "//Support:Buffer",
        "//max:CAPI.headers",
    ],
)

modular_shared_library(
    name = "max",
    srcs = glob(
        [
            "API/c/**/*.cpp",
            "MOF/API/**/*.cpp",
        ],
    ),
    hdrs = ["//max/include/max/max_license:max.headers"],
    visibility = [
        "//mach:__subpackages__",
        "//max:consumers",
    ],
    deps = [
        ":MOFDriver",
        # Profiler host glue: attaches the dlopen loader for
        # libMAXProfilerPlugin.so to this DSO's //Support:ProfilingRanges copy, so
        # MLRT's activatePendingTrace() (device init) and AsyncRT's thread
        # registration inside libmax reach the profiler.
        "//Support:ProfilerHostGlue",
        "//GraphCompiler:FrameworkFrontend",
        "//GraphCompiler:MEFModel",
        "//GraphCompiler:SafeTensor",
        "//Init",
        "//Kernels:WeightsRegistry",
        "//Support:Context",
        "//Support:Globals",
        "//Support:SpanGuard",
        "//max:CAPI.headers",
        "@llvm-project//mlir:MLIRBindingsPythonCAPIObjects",
        "@nixl_upstream//:nixl_runtime",
    ],
)
