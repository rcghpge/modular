load("//bazel:api.bzl", "mojo_library", "mojo_overlay_layer")

package(default_visibility = ["//max:consumers"])

_HAL_SRCS = glob(["**/*.mojo"])

# Base `_hal` sources. Downstream builds overlay backend-specific files onto
# this tree to extend device support (see the `_hal` overlay in
# @plugin//max/driver/src).
filegroup(
    name = "_hal_srcs",
    srcs = _HAL_SRCS,
    tags = ["maybe-unused"],  # Consumed by external plugin repos.
    visibility = ["//visibility:public"],
)

# Staged into the MAX overlay under --config=hal-device-context (see
# //max/driver/src/mcl:max_srcs_hal).
mojo_overlay_layer(
    name = "_hal_staged_layer",
    file_map = {src: "max/gpu/host/_hal/" + src for src in _HAL_SRCS},
    visibility = ["//visibility:public"],
)

mojo_library(
    name = "_hal",
    srcs = [":_hal_srcs"],
    visibility = ["//visibility:public"],
    deps = [
        "//max:max_mojo",
        "//max/driver/src/mcl/machine",
        "@mojo//:std",
    ],
)
