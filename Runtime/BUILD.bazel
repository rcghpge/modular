load("//bazel:api.bzl", "modular_cc_library")

modular_cc_library(
    name = "Runtime",
    srcs = glob(["lib/*.cpp"]),
    hdrs = glob(["include/Runtime/*.h"]),
    deps = [
        "//AsyncRT:Runtime",
        "//Support:Base",
    ],
)

modular_cc_library(
    name = "Tensor",
    srcs = glob(["lib/Tensor/*.cpp"]),
    hdrs = glob(["include/Runtime/Tensor/*.h"]),
    deps = [
        "//AsyncRT:Runtime",
    ],
)
