# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

from max.gpu.host.compile import _compile_code, get_gpu_target
from std.memory import MutPointer

def mandelbrot(output: MutPointer[Int, _]):
    output[0] = 3

# Check that we generate a single entry function for the nvptx module.
# CHECK: Generated by LLVM NVPTX Back-End
# CHECK: .visible .entry Expression_
# CHECK-NOT: .visible .entry
print(_compile_code[mandelbrot, target=get_gpu_target["sm_80"]()]())
