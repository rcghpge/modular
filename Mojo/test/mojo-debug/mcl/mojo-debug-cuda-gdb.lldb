# COM: Check `mojo debug --cuda-gdb` stuff
# RUN: mojo debug --cuda-gdb --cuda-gdb-path /foo/bar/cuda-gdb --break-on-launch --dry-run file.mojo | FileCheck %s --check-prefix=CHECK-CUDA-BREAK
# CHECK-CUDA-BREAK: /foo/bar/cuda-gdb -ex 'set cuda break_on_launch application' --args {{.*}}mojo run -O0 --debug-level=full file.mojo
