load("//bazel:api.bzl", "modular_cc_binary")

# gazelle:default_visibility //GraphCompiler:__subpackages__,//:__pkg__,//Kernels:__subpackages__

package(default_visibility = [
    "//:__pkg__",
    "//GraphCompiler:__subpackages__",
    "//Kernels:__subpackages__",
])

modular_cc_binary(
    name = "mo-opt",
    srcs = glob(["*.cpp"]),
    data = ["//max:MOGGKernelAPI"],
    mojo_deps = [
        "//max:MOGGKernelAPI",
        "//max:MOGGPrimitives",
    ],
    deps = [
        "//GraphCompiler",
        "//Init",
        "//Support:Context",
        "//Support:Globals",
        "@llvm-project//mlir:MlirOptLib",
    ],
)
