load("@mojo//:mojo.bzl", "INTERNAL_KERNEL_MOJOPKGS")
load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "test",
    size = "large",
    srcs = glob(
        ["**/*.mlir"],
    ),
    custom_substitutions = {
        "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
        "%kernel_api_test_pkg": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
        "%tensor_arg_trait_pkg": "$(rlocationpath //GraphCompiler/test/kernels/tensor_arg_trait_stubs:TensorArgTraitStubs)",
        "%tensor_arg_trait_invalid_pkg": "$(rlocationpath //GraphCompiler/test/kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs)",
        "%reduction_invalid_pkg": "$(rlocationpath //GraphCompiler/test/kernels/reduction_invalid_stubs:ReductionInvalidStubs)",
        "%stable_invalid_pkg": "$(rlocationpath //GraphCompiler/test/kernels/stable_invalid_stubs:StableInvalidStubs)",
    },
    data = [
        "//GraphCompiler/test/kernels:testing_kernels",
        "//GraphCompiler/test/kernels/reduction_invalid_stubs:ReductionInvalidStubs",
        "//GraphCompiler/test/kernels/stable_invalid_stubs:StableInvalidStubs",
        "//GraphCompiler/test/kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs",
        "//GraphCompiler/test/kernels/tensor_arg_trait_stubs:TensorArgTraitStubs",
    ],
    mojo_deps = [
        "//max:builtin_kernels",
        "//max:builtin_primitives",
    ] + INTERNAL_KERNEL_MOJOPKGS,
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GraphCompiler/tools/mo-opt",
    ],
)
