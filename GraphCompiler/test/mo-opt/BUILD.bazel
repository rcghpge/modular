load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

# Tests that require a GPU
_GPU_ONLY_TESTS = [
    "Conversion/MOToMOGG/distributed-epilogue-fusion.mlir",
]

lit_tests(
    name = "test",
    size = "large",
    srcs = glob(
        ["**/*.mlir"],
        exclude = _GPU_ONLY_TESTS,
    ),
    custom_substitutions = {
        "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/testing_kernels:MOGGKernelAPITest)",
        "%kernel_api_test_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels:MOGGKernelAPITest)",
        "%tensor_arg_trait_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels/tensor_arg_trait_stubs:TensorArgTraitStubs)",
        "%tensor_arg_trait_invalid_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs)",
    },
    data = [
        "//GraphCompiler/test/testing_kernels:MOGGKernelAPITest",
        "//GraphCompiler/test/testing_kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs",
        "//GraphCompiler/test/testing_kernels/tensor_arg_trait_stubs:TensorArgTraitStubs",
    ],
    mojo_deps = [
        "//max:builtin_kernels",
        "//max:builtin_primitives",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GraphCompiler/tools/mo-opt",
    ],
)

lit_tests(
    name = "test-gpu",
    size = "large",
    srcs = _GPU_ONLY_TESTS,
    custom_substitutions = {
        "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/testing_kernels:MOGGKernelAPITest)",
        "%kernel_api_test_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels:MOGGKernelAPITest)",
        "%tensor_arg_trait_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels/tensor_arg_trait_stubs:TensorArgTraitStubs)",
        "%tensor_arg_trait_invalid_pkg": "$(rlocationpath //GraphCompiler/test/testing_kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs)",
    },
    data = [
        "//GraphCompiler/test/testing_kernels:MOGGKernelAPITest",
        "//GraphCompiler/test/testing_kernels/tensor_arg_trait_invalid_stubs:TensorArgTraitInvalidStubs",
        "//GraphCompiler/test/testing_kernels/tensor_arg_trait_stubs:TensorArgTraitStubs",
    ],
    gpu_constraints = ["//:has_gpu"],
    mojo_deps = [
        "//max:builtin_kernels",
        "//max:builtin_primitives",
    ],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//GraphCompiler/tools/mo-opt",
    ],
)
