load("//bazel:api.bzl", "modular_cc_test")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

# Regular tests without kernel logging
modular_cc_test(
    name = "BaseTests",
    srcs = glob(
        [
            "*.cpp",
        ],
        exclude = [
            "KernelLoggerTest.cpp",
            "MGPRTTakeHandleTest.cpp",
        ],
    ),
    deps = [
        "//GraphCompiler:MGPPrimitives",
        "//GraphCompiler:SafeTensor",
        "//GraphCompiler:Support",
        "//Support:Globals",
    ],
)

# Exercises the MGP_RT_CreateAsyncDeviceBufferRefByTakingHandle entrypoint, so it
# links the //GraphCompiler:MGPRT shared library (for the extern "C" symbol) and
# //MLRT:Driver/DeviceContextImpl (to mint a CPU DeviceBuffer + install the
# current CPUDevice) on top of the BaseTests dependencies.
modular_cc_test(
    name = "MGPRTTakeHandleTest",
    size = "small",
    srcs = ["MGPRTTakeHandleTest.cpp"],
    deps = [
        "//GraphCompiler:MGPPrimitives",
        "//GraphCompiler:MGPRT",
        "//GraphCompiler:SafeTensor",
        "//GraphCompiler:Support",
        "//MLRT:Driver/DeviceContextImpl",
        "//MLRT/unittests/Driver:TestUtils",
        "//Support:Globals",
    ],
)

# Kernel logging tests - can run directly with: ./bazelw test //GraphCompiler/test/unittests:KernelLoggerTests
modular_cc_test(
    name = "KernelLoggerTests",
    srcs = [
        "KernelLoggerTest.cpp",
    ],
    local_defines = ["ENABLE_MGP_KERNEL_LOGGING"],
    tags = ["kernel_logging"],
    deps = [
        "//GraphCompiler:MGPPrimitivesWithLogging",
        "//GraphCompiler:SafeTensor",
        "//GraphCompiler:Support",
        "//Support:Globals",
    ],
)
