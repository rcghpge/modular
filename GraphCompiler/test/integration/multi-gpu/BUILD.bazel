load("//bazel:api.bzl", "lit_tests")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

# Common configuration shared across all lit_tests targets
_COMMON_CUSTOM_SUBSTITUTIONS = {
    "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
}

_COMMON_DATA = [
    "//GraphCompiler/test/kernels:testing_kernels",
    "//max/kernels/src/graph_compiler/builtin_kernels",
]

_COMMON_MOJO_DEPS = [
    "//max:builtin_kernels",
    "//max:builtin_primitives",
    "//max:extensibility",
]

_COMMON_TOOLS = [
    "//GraphCompiler/tools/mo-opt",
    "//GraphCompiler/tools/mt",
]

lit_tests(
    name = "multi-gpu-integration-test",
    srcs = glob(["**/*.mlir"]),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    gpu_constraints = ["//:has_multi_gpu"],
    mojo_deps = _COMMON_MOJO_DEPS,
    tags = ["gpu"],
    tools = _COMMON_TOOLS,
)

# Files that fail to compile under MAX_GC_USE_ADV_FUSION=1 today, found by
# sweeping this directory with the env var forced. Removing an entry should
# say which fix covers it, not just "now passes".
#
# Both entries below are pre-existing exclusions carried over unchanged from
# the mo.parallel PR -- this PR introduces no new failure, it only drops the
# two bundled-allreduce entries the collective fixes now cover. They each fail
# on a separate gap unrelated to the collective path, tracked on their own.
_ADV_FUSION_EXCLUDED_TESTS = [
    # crash: MAP SliceSpecAttr verifyInvariants assertion (a slice/view
    # lowering gap in the new system).
    "distributed-matmul.mlir",
    # compile error: the kernel's variadic `dev_ctxs` cannot resolve from a
    # single DeviceContext (variadic device-context handling).
    "multi-device-context.mlir",
]

# ============================================================================
# New tests: adv-fusion regression target (GEX-4140).
# ============================================================================
# Mirrors `multi-gpu-integration-test` above under MAX_GC_USE_ADV_FUSION=1,
# minus _ADV_FUSION_EXCLUDED_TESTS. Most of its srcs intentionally overlap
# `multi-gpu-integration-test`'s own (find_duplicate_srcs.py has a matching
# exemption for this package); a lit_tests srcs list needs real file paths,
# so unlike modular_py_test this can't be routed through a shared filegroup.
lit_tests(
    name = "multi-gpu-integration-test-adv-fusion",
    srcs = glob(
        ["**/*.mlir"],
        exclude = _ADV_FUSION_EXCLUDED_TESTS,
    ),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    env = {"MAX_GC_USE_ADV_FUSION": "1"},
    gpu_constraints = ["//:has_multi_gpu"],
    mojo_deps = _COMMON_MOJO_DEPS,
    tags = ["gpu"],
    tools = _COMMON_TOOLS,
    # Per-file generated target names would otherwise collide with
    # `multi-gpu-integration-test` above, which shares most of the same files.
    unique_suffix = "adv-fusion",
)
