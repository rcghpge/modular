load("//bazel:api.bzl", "lit_tests", "modular_py_test", "requirement")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

# Tests that are broken and need to be excluded from all targets.
_BROKEN_TESTS = [
    # TODO: fix the regex comparison for floating point numbers
    "Conversion/mogg-kernel-api-e2e-gpu-matmul.mlir",
]

# Keep broken tests referenced so linter doesn't complain about unreferenced files.
filegroup(
    name = "broken_tests",
    testonly = True,
    srcs = _BROKEN_TESTS,
    tags = ["maybe-unused"],
)

# Files that will never run under MAX_GC_USE_ADV_FUSION=1: they cover a
# feature the new path does not implement and that nothing enables. Not meant
# to empty; it goes away with the legacy path.
_ADV_FUSION_DISABLED_TESTS = [
    # Tile codegen. `tile_based_fusion` is an opt-in compile option defaulting
    # to false with no caller in this repo, and the two kernels behind it say
    # in their own headers that the plumbing is provisional. MAP implements
    # none of it: three of these fail to compile, two compile to SIMD instead
    # of tile and still return the right answer, and the negative test
    # compiles what legacy rejects. Re-enable with tile support, not before.
    "Conversion/tile-codegen-elementwise-add-mul.mlir",
    "Conversion/tile-codegen-elementwise-add.mlir",
    "Conversion/tile-codegen-matmul-epilogue-add.mlir",
    "Conversion/tile-codegen-matmul.mlir",
    "Conversion/tile-codegen-mismatch.mlir",
    "Conversion/tile-codegen-rms-norm-epilogue-store.mlir",
]

# Files that fail to compile under MAX_GC_USE_ADV_FUSION=1 today, found by
# sweeping this directory with the env var forced. Removing an entry should
# say which fix covers it, not just "now passes".
_ADV_FUSION_EXCLUDED_TESTS = [
    "E2E/device-graph-elementwise.mlir",
    "E2E/device-graph-execute-gpu.mlir",
    "E2E/device-graph-execute-only-gpu.mlir",
    "E2E/device-graph-host-input.mlir",
]

# Common configuration shared across all lit_tests targets
_COMMON_CUSTOM_SUBSTITUTIONS = {
    "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
    "%tile_kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/kernels/tile_stubs:MOGGTileKernelAPITest)",
}

_COMMON_DATA = [
    "//GraphCompiler/test/kernels:testing_kernels",
    "//GraphCompiler/test/kernels/tile_stubs:MOGGTileKernelAPITest",
    "//max/kernels/src/graph_compiler/builtin_kernels",
]

_COMMON_MOJO_DEPS = [
    "//max:builtin_kernels",
    "//max:builtin_primitives",
    "//max:extensibility",
]

_COMMON_TOOLS = [
    "//GraphCompiler/tools/mo-opt",
    "//GraphCompiler/tools/mt",
    "//GraphCompiler/test/utils/test-helper:test_vs_numpy.py",
]

lit_tests(
    name = "gpu-integration-test",
    srcs = glob(
        ["**/*.mlir"],
        exclude = _BROKEN_TESTS,
    ),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    mojo_deps = _COMMON_MOJO_DEPS,
    tags = ["gpu"],
    tools = _COMMON_TOOLS,
)

modular_py_test(
    name = "graph_api_tests",
    srcs = glob([
        "pytests/*.py",
    ]),
    data = [
        "//GraphCompiler/test/integration/gpu/pytests/testdata",
    ],
    env = {"TESTDATA_DIRECTORY": "GraphCompiler/test/integration/gpu/pytests/testdata"},
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        requirement("numpy"),
    ],
)

# ============================================================================
# New tests: adv-fusion regression target (GEX-4140).
# ============================================================================
# Mirrors `gpu-integration-test` above under MAX_GC_USE_ADV_FUSION=1, minus
# both adv-fusion lists. Most of its srcs intentionally overlap
# `gpu-integration-test`'s own (find_duplicate_srcs.py has a matching
# exemption for this package); a lit_tests srcs list needs real file paths,
# so unlike modular_py_test this can't be routed through a shared filegroup.
# No adv-fusion mirror for `graph_api_tests` (the pytest side): both of its
# only two files fail under the new system, so nothing would remain.
lit_tests(
    name = "gpu-integration-test-adv-fusion",
    srcs = glob(
        ["**/*.mlir"],
        exclude = _BROKEN_TESTS + _ADV_FUSION_DISABLED_TESTS +
                  _ADV_FUSION_EXCLUDED_TESTS,
    ),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    env = {"MAX_GC_USE_ADV_FUSION": "1"},
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    mojo_deps = _COMMON_MOJO_DEPS,
    tags = ["gpu"],
    tools = _COMMON_TOOLS,
    # Per-file generated target names would otherwise collide with
    # `gpu-integration-test` above, which shares most of the same files.
    unique_suffix = "adv-fusion",
)
