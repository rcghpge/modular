load("//bazel:api.bzl", "lit_tests", "requirement")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

# Shared test data filegroup to avoid duplicate source errors when multiple
# lit_tests targets need the same files. The find_duplicate_srcs.py checker
# ignores filegroup rules.
filegroup(
    name = "test_data",
    testonly = True,
    srcs = glob(["**/*.mojo"]),
)

# External data files needed for custom_substitutions - must be direct dependencies
# for $(rlocationpath) to resolve them.
_COMMON_DATA = [
    ":test_data",
    "//GraphCompiler/test/kernels:testing_kernels",
    "//GraphCompiler/test/utils/test-helper:test_vs_numpy.py",
]

# Common configuration shared across all lit_tests targets
_COMMON_CUSTOM_SUBSTITUTIONS = {
    "%kernel_api_test_lib": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
    "%kernel_api_test_pkg": "$(rlocationpath //GraphCompiler/test/kernels:testing_kernels)",
    "%mo_vs_numpy_py": "$(rlocationpath //GraphCompiler/test/utils/test-helper:test_vs_numpy.py)",
    "mo-opt": "$(rlocationpath //GraphCompiler/tools/mo-opt)",
    "mojo": "$(rlocationpath //Mojo/tools/mojo)",
    "mojo-lldb": "$(rlocationpath //Mojo:mojo-lldb)",
    "mt": "$(rlocationpath //GraphCompiler/tools/mt)",
}

_COMMON_MOJO_DEPS = [
    "//max:builtin_kernels",
    "//max:builtin_primitives",
    "//max:extensibility",
]

_COMMON_TOOLS = [
    "//GraphCompiler/tools/mo-opt",
    "//GraphCompiler/tools/mt",
    "//Mojo:mojo-lldb",
    "//Mojo/tools/mojo",
]

_COMMON_DEPS = [
    requirement("numpy"),
    "//GraphCompiler/test/utils/test-helper:test_vs_numpy",
]

# Files that fail under MAX_GC_USE_ADV_FUSION=1 today (compile error or wrong
# result), found by sweeping this directory with the env var forced on both
# x86 and Graviton -- a few pass on one arch and fail on the other, so the
# list is the union across arches. Removing an entry should say which fix
# covers it, not just "now passes".
_ADV_FUSION_EXCLUDED_TESTS = [
    "E2E/inline-broadcast-constant-scalars.mlir",  # correctness: wrong result on Graviton
    "E2E/mogg-kernel-api-e2e-elementwise-fusion-propagate-strides.mlir",
    "MODialect/arg-nonzero.mlir",
    "MODialect/batch-matmul.mlir",
    "MODialect/conv-epilogue-fusion.mlir",
    "MODialect/conv.mlir",
    "MODialect/conv_transpose.mlir",
    "MODialect/custom-reduce-min-max.mlir",
    "MODialect/dynamic-op-coverage.mlir",
    "MODialect/gather-trans-intensive.mlir",  # correctness: wrong result on Graviton
    "MODialect/in-place-and-cf.mlir",
    "MODialect/layer_norm.mlir",
    "MODialect/matmul-epilogue-fusion.mlir",
    "MODialect/matmuls.mlir",  # correctness: wrong result on Graviton
    "MODialect/mogg-ints.mlir",  # compile-time: times out (>800s) on Graviton
    "MODialect/mogg-kernel-api-e2e-fusion-propagate-strides.mlir",
    # Custom view-kernel graphs removed (unsupported going forward); still
    # blocked on a matmul epilogue-fusion difference (has_epilogue_fusion),
    # a separate cause from view kernels.
    "MODialect/mogg-kernel-api-e2e-fusion.mlir",
    # NPU target that must reject top-level tile projection; its device path is
    # not covered by this CPU/GPU-focused change.
    "MODialect/mogg-kernel-api-e2e-trait-tile-tensor-npu-negative.mlir",
    # Now compiles the trait lane, but reaches a separate pre-existing bug: an
    # in-place `!mo.buffer` graph output hits a null-value deref while lowering
    # `mo.output` in MOGGToMGP under advanced fusion (the `rmo-in-place` family).
    # Blocked on that fix, not the trait ABI.
    "MODialect/mogg-kernel-api-e2e-trait-mutable.mlir",
    "MODialect/non-maximum-suppression.mlir",
    "MODialect/pad.mlir",
    "MODialect/pool.mlir",
    "MODialect/random.mlir",
    "MODialect/resize.mlir",
    "MODialect/roi-align-dynamic-output-size.mlir",
    "MODialect/roi-align.mlir",
    "MODialect/top-k.mlir",
    "MODialect/while.mlir",
    "OptimizationPatterns/conv_pack_filter.mlir",
    "OptimizationPatterns/multi-head-attention-cpu-no-mask-div-normalization.mlir",
    "OptimizationPatterns/multi-head-attention-cpu-no-mask.mlir",
]

lit_tests(
    name = "tests",
    size = "enormous",
    srcs = glob(
        ["**/*.mlir"],
        exclude = ["**/*-gpu.mlir"],
    ),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    mojo_deps = _COMMON_MOJO_DEPS,
    tools = _COMMON_TOOLS,
    deps = _COMMON_DEPS,
)

# ============================================================================
# New tests: adv-fusion regression target (GEX-4140).
# ============================================================================
# Mirrors `tests` above under MAX_GC_USE_ADV_FUSION=1, minus
# _ADV_FUSION_EXCLUDED_TESTS. Most of its srcs intentionally overlap `tests`'
# own (find_duplicate_srcs.py has a matching exemption for this package, the
# same pattern mblack's unit_tests/unit_tests_validate already uses); a
# lit_tests srcs list needs real file paths (it derives each per-file target
# name straight from the string), so unlike modular_py_test this can't be
# routed through a shared filegroup.
lit_tests(
    name = "tests-adv-fusion",
    size = "enormous",
    srcs = glob(
        ["**/*.mlir"],
        exclude = ["**/*-gpu.mlir"] + _ADV_FUSION_EXCLUDED_TESTS,
    ),
    custom_substitutions = _COMMON_CUSTOM_SUBSTITUTIONS,
    data = _COMMON_DATA,
    env = {"MAX_GC_USE_ADV_FUSION": "1"},
    mojo_deps = _COMMON_MOJO_DEPS,
    tools = _COMMON_TOOLS,
    # Per-file generated target names would otherwise collide with `tests`
    # above, which shares most of the same underlying .mlir files.
    unique_suffix = "adv-fusion",
    deps = _COMMON_DEPS,
)
