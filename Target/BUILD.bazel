load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_library", "modular_cc_test")

# gazelle:default_visibility //MLRT:__subpackages__

package(default_visibility = ["//MLRT:__subpackages__"])

# Simulate independent development by an external HW vendor with minimal
# dependence on mono-repo code and bazel rules.
modular_cc_binary(
    # avoids the `lib` prefix; plugins are not traditional libs
    name = "CUDAPlugin.so",
    srcs = glob([
        "lib/CUDA/*.cpp",
        "lib/CUDA/*.h",
        "lib/CUDA/*.inc",
    ]),
    linkshared = True,
    linkstatic = False,
    target_compatible_with = select({
        "//:nvidia_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//SDK:HAL",
        "//bazel/third-party:CUDAHeaders",
        "//bazel/third-party:NVMLHeaders",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_library(
    name = "DriverPluginTests",
    testonly = True,
    srcs = ["test/Plugin.cpp"],
    copts = ["-Wno-global-constructors"],
    deps = [
        "//SDK:HAL",
        "@llvm-project//third-party/unittest:gtest",
    ],
    alwayslink = True,
)

modular_cc_test(
    name = "CUDAPluginTest",
    size = "small",
    data = [":CUDAPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :CUDAPlugin.so)",
    },
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    visibility = ["//visibility:private"],
    deps = [
        ":DriverPluginTests",
    ],
)

modular_cc_binary(
    # avoids the `lib` prefix; plugins are not traditional libs
    name = "HIPPlugin.so",
    srcs = glob(
        [
            "lib/HIP/*.cpp",
            "lib/HIP/*.h",
        ],
        allow_empty = False,
    ),
    linkopts = ["-ldl"],
    linkshared = True,
    linkstatic = False,
    target_compatible_with = select({
        "//:amd_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//SDK:HAL",
        "@hip_include//:hip_headers",
        "@llvm-project//llvm:Support",
        "@tl_expected",
    ],
)

modular_cc_test(
    name = "HIPPluginTest",
    size = "small",
    data = [":HIPPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :HIPPlugin.so)",
    },
    gpu_constraints = ["//:amd_gpu"],
    # run manually for now, as this isn't quite up to full impl coverage
    tags = [
        "gpu",
        "manual",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":DriverPluginTests",
    ],
)

modular_cc_binary(
    name = "MetalPlugin.so",
    srcs = glob([
        "lib/Metal/*.cpp",
        "lib/Metal/*.h",
    ]),
    linkshared = True,
    linkstatic = False,
    target_compatible_with = select({
        "//:apple_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//SDK:HAL",
        "//Support:Base",
        "@metal-cpp//:metal-cpp",
    ],
)

modular_cc_test(
    name = "MetalPluginTest",
    size = "small",
    data = [":MetalPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :MetalPlugin.so)",
        "OBJC_DEBUG_MISSING_POOLS": "YES",
    },
    gpu_constraints = ["//:apple_gpu"],
    tags = ["gpu"],
    visibility = ["//visibility:private"],
    deps = [
        ":DriverPluginTests",
    ],
)
