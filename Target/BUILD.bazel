load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_test")

# gazelle:default_visibility //MLRT:__subpackages__

package(default_visibility = ["//MLRT:__subpackages__"])

# Simulate independent development by an external HW vendor with minimal
# dependence on mono-repo code and bazel rules.
modular_cc_binary(
    # avoids the `lib` prefix; plugins are not traditional libs
    name = "CUDAPlugin.so",
    srcs = glob([
        "lib/CUDA/*.c",
        "lib/CUDA/*.cpp",
        "lib/CUDA/*.h",
    ]),
    linkshared = True,
    linkstatic = False,
    deps = [
        "//SDK:HAL",
    ] + select({
        "//:linux_x86_64": [
            "@cuda_cudart_x86_64//:libcuda",
            "@nvml_x86_64//:libnvml",
        ],
        "//:linux_aarch64": [
            "@cuda_cudart_aarch64//:libcuda",
            "@nvml_aarch64//:libnvml",
        ],
        "//conditions:default": [],
    }),
)

modular_cc_test(
    name = "CUDAPluginTest",
    size = "small",
    srcs = ["test/CUDA/Plugin.cpp"],
    data = [":CUDAPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :CUDAPlugin.so)",
    },
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    visibility = ["//visibility:private"],
    deps = [
        "//SDK:HAL",
    ],
)
