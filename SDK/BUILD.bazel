load("//bazel:api.bzl", "modular_cc_library")
load("//bazel:config.bzl", "TOP_LEVEL_TAG")

# gazelle:default_visibility //SDK:consumers

package(default_visibility = ["//SDK:consumers"])

package_group(
    name = "consumers",
    packages = [
        "//SDK/...",
        "//docs/...",
        "//utils/...",
    ],
)

# TODO: Remove, currently just for convenience
alias(
    name = "python",
    actual = "//max:repl",
    tags = [TOP_LEVEL_TAG],
)

# TODO: Remove, currently just for convenience
alias(
    name = "pipelines",
    actual = "//max",
    tags = [TOP_LEVEL_TAG],
)

modular_cc_library(
    name = "HAL",
    hdrs = glob([
        "include/HAL/*.h",
    ]) + [
        "include/HAL/M_driver_hal_symbols.inc",
    ],
    includes = ["include"],
    # Avoid C++ style checks for pure C
    tags = ["no-clang-tidy-headers"],
    visibility = [
        "//visibility:public",
    ],
)
