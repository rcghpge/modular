load("//bazel:api.bzl", "cc_autolink_deps", "modular_cc_library", "modular_nanobind_library", "modular_shared_library", "pkg_files", "py_repl", "requirement")
load("//SDK/lib/API/python/bindings:tblgen.bzl", "mlir_nanobind", "tblgen_nanobind")

modular_cc_library(
    name = "CAPI.headers",  # NOTE: Target only exists to run clang-tidy as C files
    testonly = True,
    srcs = glob(["include/SDK/API/max/c/*.h"]),
    includes = ["include/SDK/API"],
    tags = ["clang-tidy-is-c-tu"],
    visibility = ["//visibility:private"],
)

pkg_files(
    name = "API.c.headers",
    srcs = glob(["include/SDK/API/max/c/*.h"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "doxygen-sources",
    srcs = glob([
        "include/SDK/API/max/**",
    ]),
    visibility = ["//SDK/include/SDK/API/max/c/docs:__pkg__"],
)

modular_cc_library(
    name = "MOFDriver",
    srcs = glob(["lib/MOF/Driver/**/*.cpp"]),
    hdrs = [
        "include/SDK/MOF/InitAllDialects.h",
    ] + glob([
        "include/SDK/MOF/Driver/**/*.h",
    ]),
    deps = [
        "//GenericML:GraphCompiler",
        "//Support:Base",
        "//Support:Buffer",
    ],
)

modular_nanobind_library(
    name = "DLPackPython",
    srcs = glob(["lib/API/python/lib/DLPack/*.cpp"]),
    hdrs = glob(["include/SDK/DLPack/python/*.h"]),
    deps = ["@dlpack"],
)

modular_nanobind_library(
    name = "ModularFrameworkPython",
    srcs = glob(["lib/API/python/lib/Engine/*.cpp"]),
    hdrs = glob(["include/SDK/EngineAPI/**/*.h"]),
    tags = ["no-clang-tidy-headers"],
    deps = [
        ":max",
        "//:MLIRBindingsPythonHeaders",
        "//Init",
        "//SDK:DLPackPython",
        "//SDK:DriverPython",
    ],
)

modular_nanobind_library(
    name = "DriverPython",
    srcs = glob(["lib/API/python/lib/Driver/*.cpp"]),
    hdrs = glob(["include/SDK/DriverAPI/python/*.h"]),
    deps = [
        ":max",
        "//SDK:DLPackPython",
    ],
)

modular_nanobind_library(
    name = "GraphPython",
    srcs = glob(["lib/API/python/lib/Graph/*.cpp"]),
    hdrs = glob(["include/SDK/GraphAPI/python/*.h"]),
    deps = [
        ":max",
        "//:MLIRBindingsPythonHeaders",
    ],
)

modular_nanobind_library(
    name = "ProfilerPython",
    srcs = glob(["lib/Profiler/python/*.cpp"]),
    hdrs = glob(["include/SDK/Profiler/python/*.h"]),
    local_defines = select({
        "//:kernel_e2e_gpu_profiling_setting": ["MODULAR_ENABLE_GPU_PROFILING"],
        "//:kernel_e2e_gpu_profiling_detailed_setting": ["MODULAR_ENABLE_GPU_PROFILING_DETAILED"],
        "//conditions:default": [],
    }),
    deps = [
        "//Kernels:Tracing",
    ],
)

tblgen_nanobind(
    name = "MOSHDialectNanobindInc",
    src = "//GenericML:mosh_json",
    dialect = "MOSHDialect",
    output = "include/SDK/GraphAPI/python/mosh_dialect_nanobind.cpp.inc",
    visibility = ["//visibility:public"],
)

mlir_nanobind(
    name = "BuiltinDialectNanobindInc",
    srcs = [
        "@llvm-project//mlir:include/mlir/IR/BuiltinAttributeInterfaces.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinAttributes.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinDialect.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinLocationAttributes.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinOps.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinTypeInterfaces.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinTypes.td",
        "@llvm-project//mlir:include/mlir/Transforms/Passes.td",
    ],
    exclude = [
        "Builtin_DenseResourceElementsAttr",  # can't deal with AsmResourceBlob yet
        "Builtin_SparseElementsAttr",  # Table flip
        "OpaqueLoc",  # constructors are templatized
    ],
    output_dir = "include/SDK/GraphAPI/python",
    visibility = ["//visibility:public"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
        "@llvm-project//mlir:PassBaseTdFiles",
        "@llvm-project//mlir:RewritePassBaseTdFiles",
    ],
)

py_repl(
    name = "python",
    data = [
        ":max",
        "//GenericML:MGPRT",
    ],
    deps = [
        "//max/python/max",
        requirement("hypothesis"),
        requirement("notebook"),
        requirement("nvitop"),
        requirement("rich"),
        requirement("pytest"),
    ],
)

alias(
    name = "pipelines",
    actual = "//max/python/max/entrypoints:pipelines",
    tags = ["maybe-unused"],
)

cc_autolink_deps(
    name = "deps",
    deps = [
        "//GenericML:SafeTensor",
    ],
)

modular_shared_library(
    name = "max",
    srcs = glob([
        "lib/API/c/**/*.cpp",
        "lib/MOF/API/**/*.cpp",
    ]),
    hdrs = glob([
        "include/SDK/API/**/*.h",
        "include/SDK/MOF/API/**/*.h",
    ]),
    includes = ["include/SDK/API"],
    deps = [
        ":MOFDriver",
        ":deps",
        "//AsyncRT:NIXL",
        "//GenericML:CommonDriver",
        "//GenericML:CompileDriver",
        "//GenericML:DeviceDriver",
        "//GenericML:ExecutionDriver",
        "//GenericML:FrameworkFrontend",
        "//GenericML:GraphCompiler",
        "//GenericML:MEFModel",
        "//GenericML:MONameInputDimsPass",
        "//GenericML:MOTransforms",
        "//GenericML:RMOTransforms",
        "//GenericML:SafeTensor",
        "//Init",
        "//Kernels:WeightsRegistry",
        "//Support:Base",
        "//Support:Context",
        "//Support:CrashReporting",
        "//Support:Diagnostics",
        "//Support:Globals",
        "@llvm-project//mlir:MLIRBindingsPythonCAPIObjects",
    ],
)

modular_nanobind_library(
    name = "Support",
    hdrs = glob(["include/SDK/Support/*.h"]),
    # Added to targets to debug
    tags = ["maybe-unused"],
)
