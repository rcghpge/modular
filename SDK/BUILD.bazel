load("//bazel:api.bzl", "modular_cc_library", "modular_nanobind_library", "py_repl", "requirement")
load("//bazel:config.bzl", "CONFIG_SECTION_LOCAL_DEFINES")
load("//SDK/lib/API/python/bindings:tblgen.bzl", "mlir_nanobind", "tblgen_nanobind")

modular_cc_library(
    name = "DLPack",
    hdrs = glob(["include/SDK/DLPack/*.h"]),
)

modular_nanobind_library(
    name = "DLPackPython",
    srcs = glob(["lib/API/python/lib/DLPack/*.cpp"]),
    hdrs = glob(["include/SDK/DLPack/python/*.h"]),
    deps = [":DLPack"],
)

modular_nanobind_library(
    name = "ModularFrameworkPython",
    srcs = glob(["lib/API/python/lib/Engine/*.cpp"]),
    hdrs = glob(["include/SDK/EngineAPI/**/*.h"]),
    local_defines = CONFIG_SECTION_LOCAL_DEFINES,
    nanobind_deps = [
        "//:MLIRBindingsPythonHeaders",
        "//Support:CPythonNanobind",
        "//SDK:DriverPython",
        "//SDK:DLPackPython",
    ],
    tags = ["no-clang-tidy-headers"],
    deps = [
        "//GenericML:modular-framework-common",
        "//PyTorch:modular-framework-torch-ext",
    ],
)

modular_nanobind_library(
    name = "DriverPython",
    srcs = glob(["lib/API/python/lib/Driver/*.cpp"]),
    hdrs = glob(["include/SDK/DriverAPI/python/*.h"]),
    nanobind_deps = [
        "//SDK:DLPackPython",
    ],
    deps = [
        "//AsyncRT:DeviceContext",
        "//GenericML:DeviceDriver",
        "//GenericML:modular-framework-common",
        "//Support:ML",
        "@pybind11",
    ],
)

modular_nanobind_library(
    name = "GraphPython",
    srcs = glob(["lib/API/python/lib/Graph/*.cpp"]),
    hdrs = glob(["include/SDK/GraphAPI/python/*.h"]),
    nanobind_deps = [
        "//:MLIRBindingsPythonHeaders",
    ],
    deps = [
        "//GenericML:modular-framework-common",
        "//ModularFramework/tools/mof",
    ],
)

modular_nanobind_library(
    name = "ProfilerPython",
    srcs = glob(["lib/Profiler/python/*.cpp"]),
    hdrs = glob(["include/SDK/Profiler/python/*.h"]),
    local_defines = select({
        "//:kernel_e2e_gpu_profiling_setting": ["MODULAR_ENABLE_GPU_PROFILING"],
        "//:kernel_e2e_gpu_profiling_detailed_setting": ["MODULAR_ENABLE_GPU_PROFILING_DETAILED"],
        "//conditions:default": [],
    }),
    deps = [
        "//Kernels:Tracing",
    ],
)

tblgen_nanobind(
    name = "MODialectNanobindInc",
    src = "//GenericML:mo_json",
    dialect = "MODialect",
    output = "include/SDK/GraphAPI/python/mo_dialect_nanobind.cpp.inc",
    visibility = ["//visibility:public"],
)

tblgen_nanobind(
    name = "MOSHDialectNanobindInc",
    src = "//GenericML:mosh_json",
    dialect = "MOSHDialect",
    output = "include/SDK/GraphAPI/python/mosh_dialect_nanobind.cpp.inc",
    visibility = ["//visibility:public"],
)

mlir_nanobind(
    name = "BuiltinDialectNanobindInc",
    srcs = [
        "@llvm-project//mlir:include/mlir/IR/BuiltinAttributes.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinDialect.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinLocationAttributes.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinOps.td",
        "@llvm-project//mlir:include/mlir/IR/BuiltinTypes.td",
    ],
    exclude = [
        "Builtin_DenseResourceElementsAttr",  # can't deal with AsmResourceBlob yet
    ],
    output_dir = "include/SDK/GraphAPI/python",
    visibility = ["//visibility:public"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

py_repl(
    name = "python",
    data = [
        "//GenericML:MGPRT",
        "//KGEN:CompilerRT",
        "//KGEN:ptxas",
        "//ModularFramework/tools/mof",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    deps = [
        "//SDK/lib/API/python/max",
        requirement("hypothesis"),
        requirement("notebook"),
        requirement("nvitop"),
        requirement("pytest"),
    ],
)

alias(
    name = "pipelines",
    actual = "//SDK/lib/API/python/max/entrypoints:pipelines",
    tags = ["maybe-unused"],
)
