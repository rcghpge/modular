load("//bazel:api.bzl", "modular_py_binary", "requirement")

package(default_visibility = ["//visibility:public"])

modular_py_binary(
    name = "pipelines",
    srcs = ["pipelines.py"],
    data = [
        "//GenericML:MGPRT",
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "base2_exponential_bucket_histogram",
    },
    imports = ["."],
    deps = [
        "//SDK/lib/API/python/max/pipelines/architectures",
        "//SDK/lib/API/python/max/pipelines/cli",
        "//SDK/lib/API/python/max/pipelines/dataprocessing",
        "//SDK/lib/API/python/max/pipelines/llama3",
        "//SDK/lib/API/python/max/pipelines/llama_vision",
        "//SDK/lib/API/python/max/pipelines/nn",
        "//SDK/lib/API/python/max/pipelines/pixtral",
        "//SDK/lib/API/python/max/serve",
        "//SDK/public/max-repo/pipelines/python/mistral",
        requirement("click"),
        requirement("huggingface-hub"),
        requirement("rich"),
        requirement("pillow"),
        requirement("transformers"),
        requirement("uvicorn"),
    ],
)
