load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "pipelines",
    srcs = ["pipelines.py"],
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_MAX_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
        "MODULAR_MOJO_MAX_COMPILERRT_PATH": "$(location //KGEN:CompilerRT)",
    },
    imports = ["."],
    deps = [
        requirement("click"),
        "//SDK/lib/API/python:max_serve",
        "//SDK/public/max-repo/pipelines/python/llama3",
        "//SDK/public/max-repo/pipelines/python/text_streaming",
        "//SDK/public/max-repo/pipelines/python/utils",
    ],
)

pkg_files(
    name = "python_files",
    srcs = glob([
        "*.py",
    ]) + [
        ":requirements.txt",
    ],
)

pkg_filegroup(
    name = "pipelines_python",
    srcs = [
        ":python_files",
        "//SDK/public/max-repo/pipelines/python/llama3:python_files",
        "//SDK/public/max-repo/pipelines/python/text_streaming:python_files",
        "//SDK/public/max-repo/pipelines/python/utils:python_files",
    ],
)
