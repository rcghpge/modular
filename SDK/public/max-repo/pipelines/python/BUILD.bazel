load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")
load("//bazel:api.bzl", "modular_py_binary", "requirement")

package(default_visibility = ["//visibility:public"])

modular_py_binary(
    name = "pipelines",
    srcs = ["pipelines.py"],
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    imports = ["."],
    deps = [
        "//SDK/lib/API/python/max/serve",
        "//SDK/pipelines/pixtral",
        "//SDK/public/max-repo/pipelines/python/dataprocessing",
        "//SDK/public/max-repo/pipelines/python/llama3",
        "//SDK/public/max-repo/pipelines/python/mistral",
        "//SDK/public/max-repo/pipelines/python/nn",
        "//SDK/public/max-repo/pipelines/python/replit",
        "//SDK/public/max-repo/pipelines/python/utils",
        requirement("click"),
        requirement("ddtrace"),
        requirement("huggingface_hub"),
        requirement("opentelemetry-api"),
        requirement("opentelemetry-sdk"),
        requirement("rich"),
        requirement("torch"),
        requirement("transformers"),
        requirement("uvicorn"),
    ],
)

pkg_files(
    name = "python_files",
    srcs = glob(
        [
            "*.py",
        ],
    ) + [
        ":requirements.txt",
    ],
)

pkg_filegroup(
    name = "pipelines_python",
    srcs = [
        ":python_files",
        "//SDK/public/max-repo/pipelines/python/dataprocessing:python_files",
        "//SDK/public/max-repo/pipelines/python/llama3:python_files",
        "//SDK/public/max-repo/pipelines/python/mistral:python_files",
        "//SDK/public/max-repo/pipelines/python/nn:python_files",
        "//SDK/public/max-repo/pipelines/python/replit:python_files",
        "//SDK/public/max-repo/pipelines/python/utils:python_files",
    ],
)
