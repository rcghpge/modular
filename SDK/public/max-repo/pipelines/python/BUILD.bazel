load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files")
load("//bazel:api.bzl", "modular_py_binary", "requirement")

package(default_visibility = ["//visibility:public"])

modular_py_binary(
    name = "pipelines",
    srcs = ["pipelines.py"],
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "OTEL_EXPORTER_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "base2_exponential_bucket_histogram",
    },
    imports = ["."],
    deps = [
        "//SDK/lib/API/python/max/serve",
        "//SDK/public/max-repo/pipelines/python/architectures",
        "//SDK/public/max-repo/pipelines/python/cli",
        "//SDK/public/max-repo/pipelines/python/coder",
        "//SDK/public/max-repo/pipelines/python/dataprocessing",
        "//SDK/public/max-repo/pipelines/python/llama3",
        "//SDK/public/max-repo/pipelines/python/llama_vision",
        "//SDK/public/max-repo/pipelines/python/mistral",
        "//SDK/public/max-repo/pipelines/python/nn",
        "//SDK/public/max-repo/pipelines/python/pixtral",
        "//SDK/public/max-repo/pipelines/python/replit",
        requirement("click"),
        requirement("ddtrace"),
        requirement("huggingface_hub"),
        requirement("rich"),
        requirement("torch"),
        requirement("pillow"),
        requirement("transformers"),
        requirement("uvicorn"),
    ],
)

pkg_files(
    name = "python_files",
    srcs = glob(
        [
            "*.py",
        ],
    ) + [
        ":requirements.txt",
    ],
)

pkg_filegroup(
    name = "pipelines_python",
    srcs = [
        ":python_files",
        "//SDK/public/max-repo/pipelines/python/architectures:python_files",
        "//SDK/public/max-repo/pipelines/python/cli:python_files",
        "//SDK/public/max-repo/pipelines/python/coder:python_files",
        "//SDK/public/max-repo/pipelines/python/dataprocessing:python_files",
        "//SDK/public/max-repo/pipelines/python/llama3:python_files",
        "//SDK/public/max-repo/pipelines/python/llama_vision:python_files",
        "//SDK/public/max-repo/pipelines/python/mistral:python_files",
        "//SDK/public/max-repo/pipelines/python/nn:python_files",
        "//SDK/public/max-repo/pipelines/python/replit:python_files",
    ],
)
