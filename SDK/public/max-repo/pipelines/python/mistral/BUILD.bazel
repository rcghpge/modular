load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("//bazel:api.bzl", "modular_py_library", "requirement")

modular_py_library(
    name = "mistral",
    srcs = glob(["**/*.py"]),
    imports = [".."],
    deps = [
        "//SDK/lib/API/python/max/dtype",
        "//SDK/lib/API/python/max/engine",
        "//SDK/lib/API/python/max/graph",
        "//SDK/lib/API/python/max/pipelines",
        "//SDK/public/max-repo/pipelines/python/dataprocessing",
        "//SDK/public/max-repo/pipelines/python/nn",
        requirement("gguf"),
        requirement("numpy"),
        requirement("sentencepiece"),
        requirement("transformers"),
    ],
)

pkg_files(
    name = "python_files",
    srcs = glob(
        [
            "**/*.py",
        ],
    ),
    prefix = "mistral",
    strip_prefix = strip_prefix.from_pkg(""),
    visibility = ["//visibility:public"],
)
