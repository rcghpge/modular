load("//bazel:api.bzl", "mojo_test")

filegroup(
    name = "replit",
    srcs = glob(["*.mojo"]),
    visibility = ["//visibility:public"],
)

mojo_test(
    name = "test_logits",
    srcs = ["test_logits.mojo"],
    data = [
        "//GenericML:DeviceDriver",
        "//GenericML:MGPRT",
        "//GenericML:modular-framework-common",
        "//KGEN:CompilerRT",
        "//ModularFramework/tools/mof",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    extra_srcs = [
        "//SDK/public/max-repo/examples/graph-api",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/mojo/stdlib/stdlib",
    ],
)

