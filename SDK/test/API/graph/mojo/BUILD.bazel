load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    size = "large",
    srcs = glob(["**/*.mojo"]),
    data = [
        "//GenericML:DeviceDriver",
        "//GenericML:GraphCompiler",
        "//GenericML:MGPRT",
        "//GenericML:modular-framework-common",
        "//KGEN:CompilerRT",
        "//ModularFramework/tools/mof",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        # TODO(#23665): Fix memory leaks.
        "LSAN_OPTIONS": "detect_leaks=0",
        # TODO(#25946): Fix ODR violations.
        "ASAN_OPTIONS": "detect_odr_violation=0,use_sigaltstack=0",
    },
    mojo_deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/mojo/stdlib/stdlib",
    ],
    tools = [
        "//KGEN/tools/mojo",
    ],
)
