load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    size = "large",
    srcs = glob(
        ["**/*.mojo"],
        exclude = ["mojo/gpu/*.mojo"],
    ),
    mojo_deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/max/mojo/stdlib/stdlib",
    ],
    tools = ["//KGEN/tools/mojo"],
)

lit_tests(
    name = "gpu-test",
    size = "large",
    srcs = glob(["mojo/gpu/*.mojo"]),
    gpu_constraints = ["//:has_gpu"],
    mojo_deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/max/mojo/stdlib/stdlib",
    ],
    tags = ["gpu"],
    tools = ["//KGEN/tools/mojo"],
)
