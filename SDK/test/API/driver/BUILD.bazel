load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    size = "large",
    srcs = glob(
        ["**/*.mojo"],
        exclude = ["mojo/cuda/*.mojo"],
    ),
    mojo_deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/mojo/stdlib/stdlib",
    ],
    tools = [
        "//KGEN:ptxas",
        "//KGEN/tools/mojo",
    ],
)

lit_tests(
    name = "gpu-test",
    size = "large",
    srcs = glob(["mojo/cuda/*.mojo"]),
    gpu_constraints = ["//:has_gpu"],
    mojo_deps = [
        "//SDK/lib/API/mojo/max/max",
        "//open-source/mojo/stdlib/stdlib",
    ],
    tags = ["gpu"],
    tools = [
        "//KGEN:ptxas",
        "//KGEN/tools/mojo",
    ],
)
