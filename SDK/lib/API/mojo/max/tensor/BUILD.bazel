load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("//bazel:api.bzl", "mojo_library")

mojo_library(
    name = "tensor",
    srcs = glob(["**/*.mojo"]),
    visibility = ["//visibility:public"],
    deps = [
        "//Kernels/mojo/extensibility/tensor_internal",
    ],
)

filegroup(
    name = "docs-group",
    srcs = [
        ":tensor",
    ],
    output_group = "docs",
)

pkg_files(
    name = "docs",
    srcs = [":docs-group"],
    prefix = "tensor",
    strip_prefix = strip_prefix.from_pkg("tensor.docs"),
    visibility = ["//visibility:public"],
)
