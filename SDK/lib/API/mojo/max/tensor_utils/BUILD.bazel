load("//bazel:api.bzl", "mojo_library")

mojo_library(
    name = "tensor_utils",
    srcs = glob(["**/*.mojo"]),
    visibility = ["//visibility:public"],
    deps = [
        "//Kernels/mojo/extensibility/tensor_utils_internal",
    ],
)

filegroup(
    name = "tensor_utils.doc_group",
    srcs = [
        ":tensor_utils",
    ],
    output_group = "docs",
    visibility = ["//visibility:public"],
)
