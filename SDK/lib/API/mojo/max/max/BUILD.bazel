load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//bazel:api.bzl", "mojo_library")

mojo_library(
    name = "max",
    srcs = glob(["**/*.mojo"]),
    visibility = ["//visibility:public"],
    deps = [
        "//Kernels/mojo/_mlir",
        "//Kernels/mojo/algorithm",
        "//Kernels/mojo/benchmark",
        "//Kernels/mojo/buffer",
        "//Kernels/mojo/compile",
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/kv_cache",
        "//Kernels/mojo/runtime",
        "//SDK/lib/API/mojo/max/compiler",
        "//SDK/lib/API/mojo/max/tensor",
        "//SDK/lib/API/mojo/max/tensor_utils",
        "//open-source/mojo/stdlib/stdlib",
    ],
)

filegroup(
    name = "docs-group",
    srcs = [":max"],
    output_group = "docs",
)

pkg_files(
    name = "docs",
    srcs = [":docs-group"],
    strip_prefix = strip_prefix.from_pkg("max.docs"),
)

pkg_filegroup(
    name = "max-mojo-doc",
    srcs = [
        ":docs",
        "//Kernels/mojo/extensibility/tensor_internal:docs",
    ],
    visibility = ["//visibility:public"],
)
