load("//bazel:api.bzl", "mojo_library", "pkg_filegroup", "pkg_files", "strip_prefix")

mojo_library(
    name = "max",
    srcs = glob(["**/*.mojo"]),
    data = [
        "//SDK:max",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/API/mojo/max/tensor",
        "@mojo//:compiler",
        "@mojo//:stdlib",
    ],
)

pkg_files(
    name = "docs",
    srcs = [":max.docs"],
    strip_prefix = strip_prefix.from_pkg("max.docs"),
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "max-mojo-doc",
    srcs = [
        ":docs",
        "//open-source/max/max/kernels/src/extensibility/tensor_internal:docs",
    ],
    visibility = ["//visibility:public"],
)
