load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup", "pkg_files", "strip_prefix")
load("//bazel:api.bzl", "mojo_library")

mojo_library(
    name = "max",
    srcs = glob(["**/*.mojo"]),
    data = [
        "//GenericML:DeviceDriver",
        "//GenericML:modular-framework-common",
        "//ModularFramework/tools/max",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//Kernels/mojo/_mlir",
        "//Kernels/mojo/algorithm",
        "//Kernels/mojo/benchmark",
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/runtime",
        "//SDK/lib/API/mojo/max/compiler",
        "//SDK/lib/API/mojo/max/tensor",
        "//open-source/max/mojo/stdlib/stdlib",
    ],
)

pkg_files(
    name = "docs",
    srcs = [":max.docs"],
    strip_prefix = strip_prefix.from_pkg("max.docs"),
    visibility = ["//visibility:public"],
)

pkg_filegroup(
    name = "max-mojo-doc",
    srcs = [
        ":docs",
        "//Kernels/mojo/extensibility/tensor_internal:docs",
    ],
    visibility = ["//visibility:public"],
)
