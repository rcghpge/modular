load("@pip_deps//:requirements.bzl", "requirement")
load("//bazel:api.bzl", "py_repl")

filegroup(
    name = "dlpack_srcs",
    srcs = glob(["lib/DLPack/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

filegroup(
    name = "driver_srcs",
    srcs = glob(["lib/Driver/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

filegroup(
    name = "engine_srcs",
    srcs = glob(["lib/Engine/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

# Label for M::Graph::Python sources.
filegroup(
    name = "graph_srcs",
    srcs = glob(["lib/Graph/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

py_library(
    name = "max_engine",
    srcs = [
        "//SDK/lib/API/python/max/driver",
        "//SDK/lib/API/python/max/engine",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":max_dtype",
        ":max_graph",
        "//SDK/lib/API/python/max/_driver",
        "//SDK/lib/API/python/max/_engine",
        requirement("numpy"),
    ],
)

py_library(
    name = "max_dtype",
    srcs = [
        "//SDK/lib/API/python/max/dtype",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/API/python/max/_dtype",
        requirement("numpy"),
    ],
)

py_library(
    name = "max_graph",
    srcs = ["//SDK/lib/API/python/max/graph"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        ":max_dtype",
        "//SDK/lib/API/python/max/_graph",
        "//SDK/lib/API/python/max/mlir",
        requirement("numpy"),
    ],
)

py_library(
    name = "max_serve",
    srcs = ["//SDK/lib/API/python/max/serve"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/API/python/max/serve",
    ],
)

py_repl(
    name = "repl",
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    tags = ["manual"],
    deps = [
        ":max_engine",
        ":max_graph",
        ":max_serve",
    ],
)
