load("//bazel:api.bzl", "modular_nanobind_extension", "modular_python_binding_py_library")

modular_nanobind_extension(
    name = "core",
    srcs = glob(["*.cpp"]),
    nanobind_deps = [
        "//SDK:ModularFrameworkPython",
        "//SDK:ProfilerPython",
    ],
    deps = [
        "//AsyncRT:Runtime",
        "//Support:Base",
    ],
)

modular_python_binding_py_library(
    name = "_engine",
    srcs = glob(["*.py"]),
    bindings_data = [":core"],
    data = glob(["*.pyi"]),
)
