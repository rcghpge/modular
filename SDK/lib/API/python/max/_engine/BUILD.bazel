load("//bazel:api.bzl", "modular_pybind_extension", "modular_pybind_py_library")

package(default_visibility = ["//visibility:public"])

modular_pybind_extension(
    name = "core",
    srcs = glob(["*.cpp"]),
    pybind_deps = [
        "//SDK:ModularFrameworkPython",
    ],
    deps = [
        "//AsyncRT:Runtime",
        "//Support:Base",
    ],
)

modular_pybind_py_library(
    name = "_engine",
    srcs = glob(["*.py"]),
    data = glob(["*.pyi"]),
    pybind_data = [":core"],
)
