load("//bazel:api.bzl", "modular_pybind_extension", "modular_pybind_library", "modular_pybind_py_library")

modular_pybind_library(
    name = "MODialectPybind",
    srcs = [
        "mo.cpp",
        "//SDK:MODialectPybindInc",
    ],
    pybind_deps = [
        "//SDK:GraphPython",
    ],
    deps = [
        "//GenericML:GraphCompiler",
        "//GenericML:modular-framework-common",
        "//ModularFramework/tools/mof",
        "@llvm-project//mlir:IR",
    ],
)

modular_pybind_extension(
    name = "core",
    srcs = ["core.cpp"],
    local_defines = [
        # Set definition used in Interop.h to prefix the MLIR package.
        "MLIR_PYTHON_PACKAGE_PREFIX=max._mlir.",
    ],
    pybind_deps = [
        "//SDK:GraphPython",
        "//SDK:ProfilerPython",
        ":MODialectPybind",
    ],
    deps = [
        "//GenericML:GraphCompiler",
        "//GenericML:modular-framework-common",
        "//ModularFramework/tools/mof",
    ],
)

modular_pybind_py_library(
    name = "_graph",
    srcs = glob(["*.py"]),
    data = glob(["*.pyi"]),
    pybind_data = [":core"],
    visibility = ["//visibility:public"],
)
