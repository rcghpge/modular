load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("//bazel:api.bzl", "modular_py_library")

modular_py_library(
    name = "interfaces",
    srcs = glob(["**/*.py"]),
    imports = ["../../.."],
)

pkg_files(
    name = "python_files",
    srcs = glob(
        [
            "**/*.py",
        ],
    ),
    prefix = "interfaces",
    strip_prefix = strip_prefix.from_pkg(""),
    visibility = ["//visibility:public"],
)
