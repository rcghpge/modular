load("//bazel:api.bzl", "modular_nanobind_extension", "modular_python_binding_py_library")

modular_nanobind_extension(
    name = "core",
    srcs = glob(["*.cpp"]),
    deps = [
        "//GenericML:API.headers",
        "//GenericML:MaxAPI",
    ],
)

modular_python_binding_py_library(
    name = "_dtype",
    srcs = glob(["*.py"]),
    bindings_data = [":core"],
    data = glob(["*.pyi"]),
)
