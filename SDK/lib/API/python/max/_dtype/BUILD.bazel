load("//bazel:api.bzl", "modular_pybind_extension", "modular_pybind_py_library")

modular_pybind_extension(
    name = "core",
    srcs = glob(["*.cpp"]),
    deps = [
        "//GenericML:API.headers",
        "//GenericML:MaxAPI",
    ],
)

modular_pybind_py_library(
    name = "_dtype",
    srcs = glob(["*.py"]),
    data = glob(["*.pyi"]),
    pybind_data = [":core"],
)
