load("//bazel:api.bzl", "modular_nanobind_extension", "modular_python_binding_py_library")

modular_nanobind_extension(
    name = "core",
    srcs = ["core.cpp"],
    nanobind_deps = [
        "//SDK:ProfilerPython",
    ],
    deps = [
        "//GenericML:modular-framework-common",
        "//Support:Base",
    ],
)

modular_python_binding_py_library(
    name = "_profiler",
    srcs = glob(["*.py"]),
    bindings_data = [":core"],
    data = glob(["*.pyi"]),
    imports = ["../.."],
    visibility = ["//visibility:public"],
)
