load("@com_github_grpc_grpc//bazel:python_rules.bzl", "py_grpc_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//bazel:api.bzl", "modular_py_library", "requirement")

modular_py_library(
    name = "grpc_serve",
    srcs = [
        "__init__.py",
        "grpc_serve.py",
    ],
    imports = ["."],
    tags = ["no-mypy"],  # grpc doesn't get along with my-py
    deps = [
        ":grpc_predict_v2_grpc_py",
        ":grpc_predict_v2_py",
        ":grpc_proto",
        "//SDK/lib/API/python/max/engine",
        "//SDK/lib/API/python/max/entrypoints",
        "//SDK/lib/API/python/max/serve/pipelines",
        "//SDK/lib/API/python/max/serve/router",
        "//SDK/lib/API/python/max/serve/scheduler",
        "//SDK/lib/API/python/max/serve/schemas",
        "//SDK/lib/API/python/max/serve/telemetry",
        requirement("grpcio"),
        requirement("grpcio-tools"),
        requirement("grpcio-reflection"),
    ],
)

proto_library(
    name = "grpc_predict_v2",
    srcs = [
        "grpc_predict_v2.proto",
    ],
    visibility = ["//visibility:public"],
)

# At some point, we should move the proto and other files to the python serving
# directories since this is mostly for the triton backend.
py_grpc_library(
    name = "grpc_predict_v2_grpc_py",
    srcs = [":grpc_predict_v2"],
    visibility = ["//visibility:public"],
    deps = [":grpc_predict_v2_py"],
)

py_proto_library(
    name = "grpc_predict_v2_py",
    visibility = ["//visibility:public"],
    deps = [":grpc_predict_v2"],
)

modular_py_library(
    name = "grpc_proto",
    visibility = ["//visibility:public"],
    deps = [
        ":grpc_predict_v2_grpc_py",
        ":grpc_predict_v2_py",
    ],
)
