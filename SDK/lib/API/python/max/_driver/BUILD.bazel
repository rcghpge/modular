load("//bazel:api.bzl", "modular_pybind_extension", "modular_pybind_py_library")

modular_pybind_extension(
    name = "core",
    srcs = glob(["*.cpp"]),
    pybind_deps = [
        "//SDK:DriverPython",
        "//SDK:ProfilerPython",
    ],
    deps = [
        "//GenericML:modular-framework-common",
        "@llvm-project//llvm:Support",
    ],
)

modular_pybind_py_library(
    name = "_driver",
    srcs = glob(["*.py"]),
    data = glob(["*.pyi"]),
    pybind_data = [":core"],
)
