load("//bazel:api.bzl", "modular_py_binary", "modular_py_library", "requirement")

modular_py_library(
    name = "llasa_lib",
    srcs = [
        "__init__.py",
        "config.py",
        "model.py",
        "prompt_template.py",
        "speech_lm.py",
    ],
    imports = [".."],
    visibility = ["//visibility:public"],
    deps = [
        requirement("transformers"),
        requirement("numpy"),
        requirement("jinja2"),
        requirement("soundfile"),
        "//SDK/lib/llasa/xcodec2",
        "//max/python/max/driver",
        "//max/python/max/interfaces",
        "//max/python/max/pipelines",
    ],
)

modular_py_binary(
    name = "llasa",
    srcs = ["entrypoint.py"],
    imports = ["."],
    main = "entrypoint.py",
    visibility = ["//visibility:public"],
    deps = [
        ":llasa_lib",
        requirement("click"),
    ],
)
