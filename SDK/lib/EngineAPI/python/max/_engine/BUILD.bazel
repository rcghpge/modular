load("//bazel:api.bzl", "copy_files", "modular_pybind_extension", "modular_pybind_py_library")

package(default_visibility = ["//visibility:public"])

copy_files(
    name = "py_srcs",
    srcs = ["//SDK/lib/EngineAPI/python/bindings/max/_engine"],
    outs = [
        "__init__.py",
        "core.pyi",
    ],
)

# max._engine C extension module.
modular_pybind_extension(
    name = "core",
    srcs = [
        "//SDK/lib/EngineAPI/python/bindings/max/_engine:core_srcs",
    ],
    pybind_deps = [
        "//SDK:ModularFrameworkPython",
    ],
    deps = [
        "//Support:Base",
    ],
)

modular_pybind_py_library(
    name = "_engine_pybind",
    srcs = [],
    pybind_data = [":core"],
)

py_library(
    name = "_engine",
    srcs = [],
    data = [
        "py_srcs",
    ],
    deps = [
        ":_engine_pybind",
    ],
)
