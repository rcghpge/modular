# Use the setuptools build backend
[build-system]
requires = ["wheel", "setuptools"]
build-backend = "setuptools.build_meta"

[project]
name = "max-engine"
version = "@MODULAR_VERSION_MAJOR@.@MODULAR_VERSION_MINOR@.@MODULAR_VERSION_PATCH@"
dependencies = [
  "numpy ~= 1.18",
  "max-engine-libs==@MODULAR_VERSION_MAJOR@.@MODULAR_VERSION_MINOR@.@MODULAR_VERSION_PATCH@"
]
requires-python = ">=3.8"

[tool.setuptools]
license-files = [
  "MAX-Platform-Software-License",
  "Third-Party-Notices",
]

[tool.black]
include = '\.pyi?$'
line-length = 80
experimental-string-processing = true

[tool.cibuildwheel]
# {project} is the path to the working directory where `cibuildwheel` is run.
archs = ["native"]
before-all = "{project}/SDK/lib/EngineAPI/python/tuf_packaging/before-all.sh"
before-build = "{project}/SDK/lib/EngineAPI/python/tuf_packaging/before-build.sh @MODULAR_VERSION_MAJOR@ @MODULAR_VERSION_MINOR@ @MODULAR_VERSION_PATCH@"
build = "cp{38,39,310,311}-manylinux*"
build-frontend = "build"
environment-pass = [
  "AWS_ACCESS_KEY_ID",
  "AWS_DEFAULT_REGION",
  "AWS_REGION",
  "AWS_SECRET_ACCESS_KEY",
  "CI",
  "MAX_INSTALL_CHANNEL",
  "MOJO_INSTALL_CHANNEL",
  "SCCACHE_BUCKET",
  "SCCACHE_CACHE_SIZE",
  "SCCACHE_C_CUSTOM_CACHE_BUSTER",
  "SCCACHE_DIR",
  "SCCACHE_GHA_ENABLED",
  "SCCACHE_IDLE_TIMEOUT",
  "SCCACHE_LOG",
  "SCCACHE_PATH",
  "SCCACHE_REGION",
  "SCCACHE_S3_KEY_PREFIX",
]
manylinux-x86_64-image = "ghcr.io/modularml/modular/ai-engine-packaging-x86_64:sha-85d1b47"
manylinux-aarch64-image = "ghcr.io/modularml/modular/ai-engine-packaging-aarch64:sha-85d1b47"
skip = ["cp36-* cp37-*, *-manylinux_i686", "*-musllinux*"]

[tool.cibuildwheel.linux]
repair-wheel-command = ""

[tool.isort]
profile = "black"

[tool.cibuildwheel.macos]
# We're going to avoid building a 3.8 wheel, since installing the 3.8 toolchain on Macs requires
# for us to install Rosetta, which breaks our Mojo build.
build="cp{39,310,311}-macosx*"
before-all=""
# TODO: Enable delocate (#36535)
repair-wheel-command=""
