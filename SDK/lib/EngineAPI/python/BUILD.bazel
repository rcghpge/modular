load("@pip_deps//:requirements.bzl", "requirement")

filegroup(
    name = "cpp_srcs",
    srcs = glob(["lib/**/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

py_library(
    name = "max_engine",
    srcs = ["//SDK/lib/EngineAPI/python/max/engine"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/EngineAPI/python/max/_engine",
        "//SDK/lib/GraphAPI/python:max_graph",
        requirement("numpy"),
    ],
)
