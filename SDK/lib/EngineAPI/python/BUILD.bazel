load("@pip_deps//:requirements.bzl", "requirement")
load("//bazel:api.bzl", "py_repl")

filegroup(
    name = "driver_srcs",
    srcs = glob(["lib/Driver/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

filegroup(
    name = "engine_srcs",
    srcs = glob(["lib/Engine/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

py_library(
    name = "max_engine",
    srcs = [
        "//SDK/lib/EngineAPI/python/max/driver",
        "//SDK/lib/EngineAPI/python/max/engine",
    ],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/EngineAPI/python/max/_driver",
        "//SDK/lib/EngineAPI/python/max/_engine",
        "//SDK/lib/GraphAPI/python:max_graph",
        requirement("numpy"),
    ],
)

py_repl(
    name = "repl",
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    tags = ["manual"],
    deps = [
        ":max_engine",
    ],
)
