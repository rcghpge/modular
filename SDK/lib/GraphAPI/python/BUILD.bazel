load("@pip_deps//:requirements.bzl", "requirement")
load("//bazel:api.bzl", "modular_pybind_py_library")

# Label for M::Graph::Python sources.
filegroup(
    name = "cpp_srcs",
    srcs = glob(["lib/**/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

# Label for all bindings sources.
filegroup(
    name = "cpp_bindings_srcs",
    srcs = glob(["bindings/**/*.cpp"]),
    visibility = [":__subpackages__"],
)

modular_pybind_py_library(
    name = "max_graph",
    srcs = ["//SDK/lib/GraphAPI/python/max/graph"],
    imports = ["."],
    pybind_data = [
        "//SDK/lib/GraphAPI/python/max/graph:core",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/GraphAPI/python/max/mlir",
        requirement("numpy"),
    ],
)
