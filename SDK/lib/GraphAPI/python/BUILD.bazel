load("//bazel:api.bzl", "modular_pybind_py_library", "modular_python_editable_dir")

# Label for M::Graph::Python sources.
filegroup(
    name = "cpp_srcs",
    srcs = glob(["lib/**/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

# Label for all bindings sources.
filegroup(
    name = "cpp_bindings_srcs",
    srcs = glob(["bindings/**/*.cpp"]),
    visibility = [":__subpackages__"],
)

modular_pybind_py_library(
    name = "max_graph",
    srcs = ["//SDK/lib/GraphAPI/python/max/graph:py_srcs"],
    imports = ["."],
    pybind_data = [
        "//SDK/lib/GraphAPI/python/max/graph:core",
    ],
    visibility = ["//visibility:public"],
)

# Target for a max.graph editable installation.
modular_python_editable_dir(
    name = "max_graph_editable",
    srcs = [
        "setup.py",
        "//SDK/lib/GraphAPI/python/max/graph:modular_py_srcs",
        "//SDK/lib/GraphAPI/python/max/graph/mlir:dialect_srcs",
        "@llvm-project//mlir/python:IRPyFiles",
        "@llvm-project//mlir/python:IRPyIFiles",
        "@llvm-project//mlir/python:MlirLibsPyFiles",
    ],
    compiled_extensions = [
        "//SDK/lib/GraphAPI/python/max/graph:core",
    ],
    config_file = "pyproject.toml.in",
    prefix_map = {
        # Put Python sources directly under max/graph/mlir.
        "external/llvm-project/mlir/python": "max/graph",
        # Modular monorepo C extensions and Python sources already have the
        # correct directory structure.
        "SDK/lib/GraphAPI/python": "",
    },
    visibility = ["//visibility:public"],
)
