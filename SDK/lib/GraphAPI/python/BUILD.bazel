load("//bazel:api.bzl", "modular_pybind_py_library")

filegroup(
    name = "cpp_bindings_srcs",
    srcs = glob(["bindings/**/*.cpp"]),
    visibility = [":__subpackages__"],
)

modular_pybind_py_library(
    name = "max_graph",
    srcs = ["//SDK/lib/GraphAPI/python/max/graph:py_srcs"],
    imports = ["."],
    pybind_data = [
        "//SDK/lib/GraphAPI/python/max/graph:max-graph-core",
    ],
    visibility = ["//visibility:public"],
)
