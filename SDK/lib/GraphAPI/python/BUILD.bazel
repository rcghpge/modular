load("@pip_deps//:requirements.bzl", "requirement")

# Label for M::Graph::Python sources.
filegroup(
    name = "cpp_srcs",
    srcs = glob(["lib/**/*.cpp"]),
    visibility = ["//SDK:__pkg__"],
)

py_library(
    name = "max_graph",
    srcs = ["//SDK/lib/GraphAPI/python/max/graph"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//SDK/lib/GraphAPI/python/max/_graph",
        "//SDK/lib/GraphAPI/python/max/mlir",
        requirement("numpy"),
    ],
)
