load("//bazel:api.bzl", "modular_pybind_library", "modular_relink_object")
load("//bazel/internal:config.bzl", "PYTHON_VERSIONS", "python_version_name")  # buildifier: disable=bzl-visibility

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "_graph",
    srcs = glob([
        "**/*.py",
        "**/*.pyi",
    ]),
)

# Label for all bindings sources.
filegroup(
    name = "core_srcs",
    srcs = ["core.cpp"],
)

modular_pybind_library(
    name = "MODialectPybind",
    srcs = [
        "mo.cpp",
        "//SDK:MODialectPybindInc",
    ],
    pybind_deps = [
        "//SDK:GraphPython",
    ],
    deps = [
        "//GenericML:GraphCompiler",
        "//GenericML:modular-framework-common",
        "//ModularFramework/tools/mof",
        "@llvm-project//mlir:IR",
    ],
)

# Rewrite loader paths so that the max._graph bindings can find shared libs.
[
    modular_relink_object(
        name = python_version_name("graph-core", version) + ".fixed",
        src = "//SDK/lib/GraphAPI/python/max/_graph:" + python_version_name("core", version),
        new_root = "../lib",
    )
    for version in PYTHON_VERSIONS
]
