load("//bazel:api.bzl", "driver_option_tablegen", "modular_cc_binary", "td_library")

modular_cc_binary(
    name = "max",
    srcs = glob(["*.cpp"]),
    copts = ["-I$(GENDIR)/SDK/tools/max/"],
    deps = [
        ":DriverOptions.help_gen",
        ":DriverOptions.inc_gen",
        "//GenericML:modular-framework-common",
        "//PyTorch:modular-framework-torch-ext",
        "//SDK:EngineCLI-Benchmark",
        "//SDK:EngineCLI-Visualize",
        "//Support:Globals",
        "//Support:Init",
    ],
)

td_library(
    name = "MaxTdFiles",
    srcs = glob(["*.td"]),
    includes = ["include"],
    deps = [
        "//SDK:BenchmarkTdFiles",
        "//SDK:CommonTdFiles",
        "//SDK:VisualizeTdFiles",
        "//Support:DriverCommandTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

driver_option_tablegen(
    name = "DriverOptions",
    srcs = ["DriverOptions.td"],
    manual_name = "max",
    markdown_name = "index",
    td_file = "DriverOptions.td",
    deps = [
        ":MaxTdFiles",
    ],
)
