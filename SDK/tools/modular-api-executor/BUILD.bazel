load("//bazel:api.bzl", "modular_cc_binary", "run_tool")

modular_cc_binary(
    name = "modular-api-executor",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//ArraySupport",
        "//GenericML:ExecutionDriver",
        "//GenericML:MaxAPI",
        "//ModularFramework/tools/mof",
        "//ONNX:APIStrippedHeaders",
        "//ONNX:modular-framework-onnx-ext",
        "//ONNX/tools/onnx:monnx",
        "//SDK:EngineCLI-Benchmark",
        "//Support:Globals",
    ],
)

run_tool(
    name = "modular-api-executor-standalone",
    data = [
        "//KGEN:CompilerRT",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    tags = ["manual"],
    tool = ":modular-api-executor",
    visibility = ["//visibility:private"],
)
